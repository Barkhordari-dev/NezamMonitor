<Application x:Class="NezamMonitorPro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NezamMonitorPro.App.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design base theme (provides control styles + MDL2 icon font) -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Amber" />

                <!-- Nezam Monitor PRO design system -->
                                <ResourceDictionary Source="pack://application:,,,/Themes/ProTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══ Converters ══ -->
            <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <local:StringToVisibilityConverter x:Key="StringToVisConverter"/>
            <local:BoolToArrowConverter x:Key="BoolToArrowConverter"/>
            <local:StageConverter x:Key="StageConverter"/>
            <local:TabToVisibilityConverter x:Key="TabToVisConverter"/>
            <local:TabBgConverter x:Key="TabBgConverter"/>
            <local:TabFgConverter x:Key="TabFgConverter"/>
            <local:ReportCountConverter x:Key="ReportCountConverter"/>
            <local:LevelToBrushConverter x:Key="LevelToBrushConverter"/>
            <local:LevelToBgBrushConverter x:Key="LevelToBgBrushConverter"/>
            <local:ZeroToGrayConverter x:Key="ZeroToGrayConverter"/>
            <local:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
            <local:CountToBadgeVisibilityConverter x:Key="OverdueBadgeVis"/>
            <local:CountToBadgeVisibilityConverter x:Key="UpcomingBadgeVis"/>

            <!-- ══ Fallback brush defaults (overridden at runtime by ThemeManager) ══ -->
                        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
                        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1D4ED8"/>
                        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1E40AF"/>
                        <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="#93C5FD"/>
                        <SolidColorBrush x:Key="SecondaryBrush" Color="#0EA5E9"/>
                        <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
                        <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC"/>
                        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
                        <SolidColorBrush x:Key="PanelBrush" Color="#F1F5F9"/>
                        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF"/>
                        <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#2563EB"/>
                        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1D4ED8"/>
                        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1E40AF"/>
                        <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#93C5FD"/>
                        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF"/>
                        <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
                        <SolidColorBrush x:Key="TextBrush" Color="#0F172A"/>
                        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
                        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
                        <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1E293B33"/>
                        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
                        <SolidColorBrush x:Key="WarningBrush" Color="#D97706"/>
                        <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
                        <SolidColorBrush x:Key="InfoBrush" Color="#2563EB"/>
                        <!-- Defaults for the derived brushes ThemeManager sets
                             in ApplyTheme; present here so DynamicResource
                             lookups resolve even before the first ApplyTheme. -->
                        <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="OnSuccessBrush" Color="#111827"/>
                        <SolidColorBrush x:Key="OnWarningBrush" Color="#111827"/>
                        <SolidColorBrush x:Key="OnErrorBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="OnInfoBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="OnSecondaryBrush" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D4ED8"/>
                        <SolidColorBrush x:Key="AccentTextBrush" Color="#6D28D9"/>
                        <SolidColorBrush x:Key="SuccessTextBrush" Color="#047857"/>
                        <SolidColorBrush x:Key="WarningTextBrush" Color="#92400E"/>
                        <SolidColorBrush x:Key="ErrorTextBrush" Color="#B91C1C"/>
                        <SolidColorBrush x:Key="SidebarBrush" Color="#1E293B"/>
                        <SolidColorBrush x:Key="SidebarTextBrush" Color="#F8FAFC"/>
                        <SolidColorBrush x:Key="SidebarActiveBrush" Color="#2563EB"/>
                        <SolidColorBrush x:Key="SidebarActiveSoftBrush" Color="#26FFFFFF"/>
                        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#14FFFFFF"/>
                        <SolidColorBrush x:Key="LogBackgroundBrush" Color="#0B1220"/>
                        <SolidColorBrush x:Key="ShadowColorBrush" Color="#0B1B33"/>
                        <Color x:Key="ShadowColor">#0B1B33</Color>

            <!-- ══ Flow direction defaults (RTL) — overridden by ThemeManager ══ -->
            <FlowDirection x:Key="MainWindowFlowDirection">RightToLeft</FlowDirection>
            <FlowDirection x:Key="TextFlowDirection">RightToLeft</FlowDirection>
            <FlowDirection x:Key="TableFlowDirection">RightToLeft</FlowDirection>
            <!-- Table text alignment (default Center; user-selectable in
                 Settings, persisted as theme_TableAlignment). -->
            <TextAlignment x:Key="TableTextAlignment">Center</TextAlignment>
            <HorizontalAlignment x:Key="TableContentAlignment">Center</HorizontalAlignment>
            <FlowDirection x:Key="MenuFlowDirection">RightToLeft</FlowDirection>

            <!-- ══ Global window / control defaults ══ -->
            <Style TargetType="Window">
                <Setter Property="FlowDirection" Value="{DynamicResource MainWindowFlowDirection}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
                <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            </Style>

            <Style TargetType="UserControl">
                <Setter Property="FlowDirection" Value="{DynamicResource MainWindowFlowDirection}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            </Style>

            <Style TargetType="Page">
                <Setter Property="FlowDirection" Value="{DynamicResource MainWindowFlowDirection}"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            </Style>

            <Style TargetType="Frame">
                <Setter Property="FlowDirection" Value="{DynamicResource MainWindowFlowDirection}"/>
                <!-- RTL + default Left content alignment = content glued to the right edge
                     with empty white space on the left. Always stretch the page. -->
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>

            <Style TargetType="DataGrid" BasedOn="{StaticResource ProDataGrid}"/>

            <Style TargetType="Menu">
                <Setter Property="FlowDirection" Value="{DynamicResource MenuFlowDirection}"/>
            </Style>
            <Style TargetType="ContextMenu">
                <Setter Property="FlowDirection" Value="{DynamicResource MenuFlowDirection}"/>
            </Style>
            <Style TargetType="MenuItem" BasedOn="{StaticResource ProMenuItem}"/>

            <Style TargetType="TextBox" BasedOn="{StaticResource ProTextBox}"/>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource ProPasswordBox}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource ProComboBox}"/>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ProComboBoxItem}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource ProCheckBox}"/>
            <Style TargetType="Button" BasedOn="{StaticResource ProButton}"/>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource ProProgressBar}"/>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ProScrollBar}"/>

            <!-- Legacy resource aliases so older views keep working -->
            <Style x:Key="NavButton" TargetType="RadioButton" BasedOn="{StaticResource ProNavItem}"/>
            <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource ProCard}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
