    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="32"
                      ShadowDepth="6"
                      Direction="270"
                      Opacity="0.18"
                      Color="{DynamicResource ShadowColor}"/>

    <DropShadowEffect x:Key="InputShadowEffect"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Direction="270"
                      Opacity="0.12"
                      Color="{DynamicResource ShadowColor}"/>

    <!-- Color resources for gradient backgrounds (ARGB format) -->
    <Color x:Key="PrimaryColor">#FF2563EB</Color>
    <Color x:Key="AccentColor">#FF7C3AED</Color>

        <Style x:Key="EyeButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="4"/>
        <!-- TTP-003: یک Tooltip برای همه دکمه‌های چشم رمز -->
        <Setter Property="ToolTip" Value="نمایش یا پنهان کردن رمزی که نوشته‌ای."/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}">
                        <TextBlock x:Name="icon" 
                                   Text="&#xE7B3;" 
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="icon" Property="Text" Value="&#xED1A;"/>
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<!-- Easing functions -->
    <QuarticEase x:Key="EaseOutQuart" EasingMode="EaseOut"/>

