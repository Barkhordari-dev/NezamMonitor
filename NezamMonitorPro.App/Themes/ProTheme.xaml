<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:NezamMonitorPro.App.Converters"
                    xmlns:services="clr-namespace:NezamMonitorPro.App.Services">

    <!-- ══════════════════════════════════════════════════════════════
         NEZAM MONITOR PRO — DESIGN SYSTEM
         طراحی مدرن، کارت‌محور، با سایه نرم و گوشه‌های گرد
         ══════════════════════════════════════════════════════════════ -->

    <!-- ─── Typography ─── -->
    <!-- پیش‌فرض‌ها با ThemeFonts یکی‌اند (T-020): اگر اینجا عوض شود،
         ThemeManager.ApplyTheme همان‌جا با مقدار تم بازنویسی‌شان می‌کند. -->
    <sys:Double x:Key="FontSize">14</sys:Double>
    <sys:Double x:Key="HeadingFontSize">20</sys:Double>
    <sys:Double x:Key="SubHeadingFontSize">17</sys:Double>
    <sys:Double x:Key="ButtonFontSize">13</sys:Double>
    <sys:Double x:Key="InputFontSize">13</sys:Double>
    <sys:Double x:Key="LabelFontSize">13</sys:Double>
    <sys:Double x:Key="LogFontSize">11</sys:Double>
    <sys:Double x:Key="SidebarFontSize">14</sys:Double>
    <sys:Double x:Key="CaptionFontSize">11.5</sys:Double>
    <sys:Double x:Key="DisplayFontSize">30</sys:Double>
    <!-- Font chain: first family is tried first, the rest are fallbacks
         (WPF FontFamily IS a comma-separated fallback list; "Tahoma, Bold"
         is the same syntax with a weight). B Nazanin is bundled with the
         app (Fonts/BNazanin.ttf) and referenced through a pack:// URI in
         ThemeManager.BuildFontFamily, so Persian text renders identically
         on every Windows box even when B Nazanin is not installed. -->
    <FontFamily x:Key="FontFamily">B Nazanin, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">B Nazanin, Tahoma, Arial</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="NumericFontFamily">Segoe UI</FontFamily>

    <!-- ─── Radii ─── -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">18</CornerRadius>
    <!-- T-014: دو توکن تازه تا گوشه‌های ۹ تا ۱۶ هم به توکن بخورند -->
    <CornerRadius x:Key="RadiusIcon">10</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">14</CornerRadius>

    <!-- ══════════════════════════════════════════════════════════════
         BUTTON STYLE TOKENS — the button look the user picks in Settings
         ("حالت دکمه‌ها"). The button templates below read these with
         DynamicResource, so switching the style updates every button
         live. ButtonStyleManager (Services) sets them and persists the
         choice as theme_ButtonStyle. Defaults = Classic.
         ══════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <SolidColorBrush x:Key="ButtonOverlayBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="ButtonFrameBrush" Color="#00000000"/>
    <Thickness x:Key="ButtonFrameThickness">0</Thickness>
    <x:Null x:Key="ButtonShadowEffect"/>

    <!-- Latin font for file paths: B Nazanin renders path text (Latin
         letters + digits) mixed with Persian, so paths get Segoe UI and
         run left-to-right. -->
    <FontFamily x:Key="PathFontFamily">Segoe UI</FontFamily>
    <Style x:Key="PathTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PathFontFamily}"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- ─── Spacing ─── -->
    <sys:Double x:Key="SpaceXS">4</sys:Double>
    <sys:Double x:Key="SpaceS">8</sys:Double>
    <sys:Double x:Key="SpaceM">14</sys:Double>
    <sys:Double x:Key="SpaceL">20</sys:Double>
    <sys:Double x:Key="SpaceXL">28</sys:Double>

    <!-- ══════════════════════════════════════════════════════════════
         CARD — the core building block
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ProCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#0B1B33"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProCardFlat" TargetType="Border" BasedOn="{StaticResource ProCard}">
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <Style x:Key="ProCardHeader" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,0,0,12"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         TYPOGRAPHY STYLES
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ProHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource HeadingFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="ProSubHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource SubHeadingFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="ProBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <Style x:Key="ProCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="ProSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource SubHeadingFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <!-- Page title shown at the top of each view -->
    <Style x:Key="ProPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource HeadingFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         BUTTONS
         ══════════════════════════════════════════════════════════════ -->
    <DataTemplate x:Key="WrappingTextTemplate">
        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </DataTemplate>
    <local:StringContentTemplateSelector x:Key="StringContentTemplateSelector"
                                         StringTemplate="{StaticResource WrappingTextTemplate}"/>

    <Style x:Key="ProButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource ButtonFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <!-- T-005: ارتفاع از تم می‌آید (ThemeManager: ButtonHeight) -->
        <Setter Property="MinHeight" Value="{DynamicResource ButtonHeight}"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="20,8"/>
        <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        <!-- String content is rendered through the wrapping template so long
             labels wrap instead of clipping when the font grows. The
             selector returns null for non-string content, so icon TextBlocks
             and icon+label StackPanels are shown directly (a plain
             ContentTemplate would override them and render their type name
             as literal text — that broke the top-bar shortcut buttons, the
             password windows' close buttons and UpdateView's action buttons).
             See Converters/StringContentTemplateSelector.cs. -->
        <Setter Property="ContentTemplateSelector" Value="{StaticResource StringContentTemplateSelector}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ButtonFrameBrush}"
                            BorderThickness="{DynamicResource ButtonFrameThickness}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Effect="{DynamicResource ButtonShadowEffect}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="overlay" Background="{DynamicResource ButtonOverlayBrush}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- T-017: بازخورد هاور/فشرده‌شدن — روی لایه داخلی اعمال
                             می‌شود تا رنگ خود دکمه (مثلا آبی دکمه آیکون) سر جایش
                             بماند و فقط یک سایه ملایم رویش بیاید -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="overlay" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="overlay" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <!-- A11Y-002: نشانگر فوکوس — حاشیه ۲ پیکسلی با رنگ اصلی تم -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ProButton" TargetType="Button" BasedOn="{StaticResource ProButtonBase}">
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource ButtonFrameBrush}"
                            BorderThickness="{DynamicResource ButtonFrameThickness}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Effect="{DynamicResource ButtonShadowEffect}"
                            SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource ButtonOverlayBrush}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                        </Trigger>
                        <!-- A11Y-002: نشانگر فوکوس — حاشیه ۲ پیکسلی با رنگ اصلی تم -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProButtonSuccess" TargetType="Button" BasedOn="{StaticResource ProButton}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSuccessBrush}"/>
    </Style>

    <Style x:Key="ProButtonDanger" TargetType="Button" BasedOn="{StaticResource ProButton}">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnErrorBrush}"/>
    </Style>

    <Style x:Key="ProButtonWarning" TargetType="Button" BasedOn="{StaticResource ProButton}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnWarningBrush}"/>
    </Style>

    <Style x:Key="ProButtonGhost" TargetType="Button" BasedOn="{StaticResource ProButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            Effect="{DynamicResource ButtonShadowEffect}"
                            SnapsToDevicePixels="True">
                        <Border Background="{DynamicResource ButtonOverlayBrush}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <!-- A11Y-002: نشانگر فوکوس — حاشیه ۲ پیکسلی با رنگ اصلی تم -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only square button -->
    <Style x:Key="ProIconButton" TargetType="Button" BasedOn="{StaticResource ProButtonBase}">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         NAVIGATION — sidebar items
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ProNavItem" TargetType="RadioButton">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Margin" Value="10,3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="GroupName" Value="ProNav"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource SidebarFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Soft rounded pill for the active item, on the right edge -->
                            <Border x:Name="accent" Width="4" Height="24" CornerRadius="2"
                                    HorizontalAlignment="Right" Background="{DynamicResource SidebarTextBrush}"
                                    Opacity="0.9"/>
                            <ContentPresenter Margin="18,0,14,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover on inactive items: a faint overlay so the row is discoverable -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                        </MultiTrigger>
                        <!-- Active item: soft, low-saturation tint + rounded corners -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SidebarActiveSoftBrush}"/>
                            <Setter TargetName="accent" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab headers: the default WPF TabItem rounds only the TOP corners,
         which looks like a button with two rounded and two sharp sides.
         Ours is rounded on all four corners, like every other button. -->
    <Style x:Key="ProTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonPrimaryBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource ProTabItem}"/>

    <!-- ══════════════════════════════════════════════════════════════
         INPUTS
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ProTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource InputFontSize}"/>
        <!-- T-005: ارتفاع از تم می‌آید (ThemeManager: InputHeight) -->
        <Setter Property="MinHeight" Value="{DynamicResource InputHeight}"/>
        <!-- Horizontal padding only: B Nazanin needs a ~26px line at 13pt,
             and any vertical padding eats the room the line needs inside a
             38px box, so the text was trimmed top and bottom. -->
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSmall}" SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Watermark layer: the grey hint sits behind the text
                                 and is hidden as soon as the field has content. -->
                            <ContentPresenter x:Name="PART_Watermark"
                                              Content="{Binding (local:Watermark.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{TemplateBinding Tag}"
                                              Visibility="Collapsed"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          VerticalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="1.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource InputFontSize}"/>
        <!-- T-005: ارتفاع از تم می‌آید (ThemeManager: InputHeight) -->
        <Setter Property="MinHeight" Value="{DynamicResource InputHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{StaticResource RadiusSmall}" SnapsToDevicePixels="True"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid IsHitTestVisible="False" Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="cp" Grid.Column="0" VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBlock x:Name="arrow" Grid.Column="1" Text="&#xE70D;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade"
                               Focusable="False" MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}"
                                    Margin="0,4,0,0" MaxHeight="320">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#0B1B33"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="180" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="arrow" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource InputFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource RadiusSmall}" Margin="4,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource InputFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ProPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource InputFontSize}"/>
        <!-- T-005: ارتفاع از تم می‌آید (ThemeManager: InputHeight) -->
        <Setter Property="MinHeight" Value="{DynamicResource InputHeight}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusSmall}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      VerticalAlignment="Stretch"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Path TextBox: ProTextBox look, but Latin font + LTR (paths). -->
    <Style x:Key="PathTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ProTextBox}">
        <Setter Property="FontFamily" Value="{StaticResource PathFontFamily}"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <!-- Shared DataGrid cell/header styles.
         GridCellEllipsis: right-aligned text, clipped text shows '...' and the
         full text in a tooltip (bound to the cell's own Text).
         GridHeaderCenter / GridCellEllipsisCenter: the centred pair, used only
         for narrow numeric/symbol columns (row number, count, checkbox-like
         values) so header and cell stay aligned together. -->
    <Style x:Key="GridCellEllipsis" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>
    <Style x:Key="GridCellEllipsisCenter" TargetType="TextBlock" BasedOn="{StaticResource GridCellEllipsis}">
        <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
    </Style>
    <Style x:Key="GridCellPath" TargetType="TextBlock" BasedOn="{StaticResource GridCellEllipsis}">
        <Setter Property="FontFamily" Value="{StaticResource PathFontFamily}"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    <Style x:Key="GridHeaderCenter" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="{DynamicResource TableContentAlignment}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         DATA GRID
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ProDataGrid" TargetType="DataGrid">
        <!-- Header checkbox of the row-selection column -> select/deselect
             all rows (SelectAllHeaderBehavior). Listed BEFORE the alignment
             menu so that behavior records the centred header style as the
             column's original. Right-click a column header -> per-column
             alignment menu (DataGridColumnAlignment); Recycling reuses row
             containers on scroll instead of rebuilding them every time. -->
        <Setter Property="services:SelectAllHeaderBehavior.EnableSelectAll" Value="True"/>
        <Setter Property="services:DataGridColumnAlignment.EnableHeaderMenu" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <!-- Tables must always be able to scroll horizontally: the app
             never set this anywhere, so on a small monitor a wide table
             showed no horizontal scrollbar at all. Stated here so every
             DataGrid gets it (the implicit style in App.xaml applies this
             to all grids), and repeated on each grid in the views. -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinRowHeight" Value="38"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource ZebraRowBrush}"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="AutoGenerateColumns" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="FlowDirection" Value="{DynamicResource TableFlowDirection}"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource InputFontSize}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="HorizontalContentAlignment" Value="{DynamicResource TableContentAlignment}"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridColumnHeader">
                                <Grid>
                                    <Grid.Resources>
                                        <!-- Headers are plain strings: without
                                             trimming, a long header in a narrow
                                             column is cut off mid-word instead
                                             of ending in '…'. Applies to the
                                             auto-generated header text and to
                                             custom header TextBlocks alike. -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </Grid.Resources>
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <!-- Sort arrow: shown only on the sorted column.
                                             Inner Grid is forced LeftToRight so the arrow stays on
                                             the physical left even though the grid is RightToLeft. -->
                                        <Grid FlowDirection="LeftToRight">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SortArrow" Grid.Column="0" VerticalAlignment="Center"
                                                       Margin="2,0,4,0" FontSize="10" FontFamily="Segoe UI Symbol"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                                            <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </Border>
                                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8"
                                           Cursor="SizeWE" Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="8"
                                           Cursor="SizeWE" Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter TargetName="SortArrow" Property="Text" Value="&#x25B2;"/>
                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter TargetName="SortArrow" Property="Text" Value="&#x25BC;"/>
                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <!-- Row-level hover: a DataGridCell only sees IsMouseOver over that
             single cell, so the highlight is attached to the row instead. -->
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TableRowHoverBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="HorizontalContentAlignment" Value="{DynamicResource TableContentAlignment}"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Soft selection instead of a saturated blue block:
                             easier on the eyes and still clearly readable. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource TableRowSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         MISC CONTROLS
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="ProProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- The template root must be a Grid whose DIRECT children are
                         PART_Track and PART_Indicator - WPF's ProgressBar looks
                         them up as template children and arranges the indicator
                         as a fraction of the track. Anything nested deeper
                         yields a zero-width indicator (an empty-looking bar). -->
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" Fill="Transparent"/>
                                <Rectangle x:Name="PART_Indicator"
                                           Fill="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <!-- Orientation is bound to the ScrollBar itself
                             (the old trigger-only set left the Track vertical
                             until the trigger ran); the trigger below only
                             flips the direction and the page commands. -->
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <!-- The minimums live on the Thumb itself (the
                                     Border inside only stretches to fill it):
                                     a vertical bar needs a tall-enough thumb,
                                     a horizontal bar a wide-enough one. The
                                     trigger below swaps them, so a horizontal
                                     thumb never asks for 24px of height in a
                                     14px bar (which made the bar's row in the
                                     DataGrid template 24px tall for nothing). -->
                                <Thumb x:Name="ThumbPart" MinWidth="10" MinHeight="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource TextSecondaryBrush}" Opacity="0.85" CornerRadius="4"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PART_IncreaseRepeatButton" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PART_DecreaseRepeatButton" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Horizontal scrollbar: the direction must not be
                             reversed and the page buttons must page left/right,
                             otherwise the thumb is mirrored (dragging right
                             scrolls left) and paging goes the wrong way.
                             (The Track's Orientation itself comes from the
                             TemplateBinding above.) -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="ThumbPart" Property="MinWidth" Value="24"/>
                            <Setter TargetName="ThumbPart" Property="MinHeight" Value="10"/>
                            <Setter TargetName="PART_IncreaseRepeatButton" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            <Setter TargetName="PART_DecreaseRepeatButton" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="14"/>
                <Setter Property="Width" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ProSeparator" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,10"/>
    </Style>

    <Style x:Key="ProMenuItem" TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

<!-- ═══════════════════════════════════════════════════════════════
         EFFECTS & ANIMATIONS
