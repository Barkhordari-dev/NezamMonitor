<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\NezamMonitorPro.Core\NezamMonitorPro.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TargetPlatformVersion></TargetPlatformVersion>
    <RuntimeFrameworkVersion>8.0.0</RuntimeFrameworkVersion>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Release/publish size optimization (no business-logic change) -->
    <SatelliteResourceLanguages>fa;en</SatelliteResourceLanguages>
    
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app_logo.png" />
  </ItemGroup>
</Project>