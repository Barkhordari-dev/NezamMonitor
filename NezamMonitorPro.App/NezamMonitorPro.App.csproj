<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
      <ProjectReference Include="..\NezamMonitorPro.Core\NezamMonitorPro.Core.csproj" />
      <ProjectReference Include="..\..\..\NezamMonitorPro.Security\NezamMonitorPro.Security.csproj" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentWPF" Version="0.10.2" />
    <PackageReference Include="MaterialDesignColors" Version="5.2.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>NezamMonitorPro.App</RootNamespace>
    <AssemblyName>NezamMonitorPro</AssemblyName>
  </PropertyGroup>

  <!-- App resources (icon + logo) — REQUIRED, otherwise the app crashes on startup -->
  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app_logo.png" />
  </ItemGroup>

  <!-- Embedded Persian font (Vazirmatn) so the UI looks identical on any Windows box -->
  <ItemGroup>
    <Resource Include="Fonts\Vazirmatn-Regular.ttf" />
  </ItemGroup>

  <!-- Publish: single-file, self-contained, compressed -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableCompressionInPublish>true</EnableCompressionInPublish>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>fa;en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSymbols>false</IncludeSymbols>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>
</Project>
