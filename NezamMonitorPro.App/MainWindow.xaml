<Window x:Class="NezamMonitorPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="سیستم مانیتورینگ نظام مهندسی نسخه پرو"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource FontFamily}"
        Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding GoToUpdateCommand}"/>
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding GoToGeneratorCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding GoToDashboardCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="SidebarColumn" Width="264"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════ SIDEBAR (right side) ════════════════ -->
        <Border x:Name="SidebarBorder" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Background="{DynamicResource SidebarBrush}" FlowDirection="RightToLeft">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="18,20,18,16">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Right" Margin="0,0,0,12">
                        <TextBlock Text="&#xE1D3;" FontFamily="{DynamicResource IconFontFamily}" FontSize="26"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="سیستم مانیتورینگ" FontSize="19" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Right" TextWrapping="Wrap"/>
                    <TextBlock Text="نظام مهندسی — نسخه پرو" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarTextBrush}"
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    <TextBlock Text="Engineering Monitoring System Pro" FontSize="10.5" Foreground="#8FA3BC"
                               FontFamily="Segoe UI" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    <Border Height="3" Width="46" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Search -->
                <Grid Grid.Row="1" Margin="16,0,16,14">
                    <TextBox x:Name="NavSearchBox" Height="38" Padding="12,0,34,0"
                             FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                             Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                             TextChanged="NavSearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" Focusable="False"/>
                                        <TextBlock Text="&#xE721;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="14" Foreground="#9FB3CC" HorizontalAlignment="Right"
                                                   Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>

                <!-- Nav items -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,0,10">
                    <StackPanel x:Name="SidebarStackPanel">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource ProNavItem}" Tag="dashboard"
                                     IsChecked="True" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="داشبورد" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavUpdate" Style="{StaticResource ProNavItem}" Tag="update" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="به‌روزرسانی" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavGenerator" Style="{StaticResource ProNavItem}" Tag="generator" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70C;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="تولید گزارش" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavCases" Style="{StaticResource ProNavItem}" Tag="cases" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="پرونده‌ها" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavReports" Style="{StaticResource ProNavItem}" Tag="reports" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="گزارش‌ها" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavExcel" Style="{StaticResource ProNavItem}" Tag="excel" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="خروجی اکسل" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavAndroid" Style="{StaticResource ProNavItem}" Tag="androidexport" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="خروجی اندروید" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavEngineers" Style="{StaticResource ProNavItem}" Tag="engineers" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="مهندسین" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavFees" Style="{StaticResource ProNavItem}" Tag="fees" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE825;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="حق‌الزحمه" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavFollowUp" Style="{StaticResource ProNavItem}" Tag="followup" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="پیگیری" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavChanges" Style="{StaticResource ProNavItem}" Tag="changes" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="تغییرات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavHistory" Style="{StaticResource ProNavItem}" Tag="history" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE823;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="تاریخچه" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavSettings" Style="{StaticResource ProNavItem}" Tag="settings" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                <TextBlock Text="تنظیمات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="3" Background="#0A0F1A" Padding="16,12">
                    <StackPanel>
                        <Border Height="1" Background="#1F2937" Margin="0,0,0,10"/>
                        <TextBlock Text="نسخه ۳ پرو" Foreground="{DynamicResource SidebarTextBrush}" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="ساخته شده توسط مهندس محمد مهدی برخورداری"
                                   Foreground="#A8B8CC" FontSize="13"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,7,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="&#xE717;" FontFamily="{DynamicResource IconFontFamily}" FontSize="13"
                                       Foreground="#A8B8CC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="09022233357" Foreground="#D3DEEB" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════ MAIN AREA ════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="داشبورد" Style="{StaticResource ProPageTitle}"/>
                        <TextBlock x:Name="PageSubtitleText" Text="نمای کلی وضعیت پرونده‌ها"
                                   Style="{StaticResource ProCaption}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Connection chip -->
                        <Border Background="{DynamicResource PanelBrush}" CornerRadius="16"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,5" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="دیتابیس محلی" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource ProIconButton}" ToolTip="به‌روزرسانی (Ctrl+O)"
                                Click="GoToUpdate_Click" Background="{DynamicResource PrimaryBrush}" Margin="0,0,8,0">
                            <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Style="{StaticResource ProIconButton}" ToolTip="تنظیمات"
                                Click="GoToSettings_Click" Background="{DynamicResource PanelBrush}">
                            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
                <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="Transparent"
                       FlowDirection="{DynamicResource MainWindowFlowDirection}"/>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar x:Name="StatusProgress" Grid.Column="1" Width="180" Height="6"
                                 Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
