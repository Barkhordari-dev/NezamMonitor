<Window x:Class="NezamMonitorPro.App.Views.FeeReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دریافتی" Height="470" Width="580"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontSize="{DynamicResource FontSize}"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="12" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusMedium}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="💰 ثبت دریافتی" FontSize="{DynamicResource SubHeadingFontSize}" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}" ToolTip="ثبت یک واریزی برای یک حق‌الزحمه."/>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- 40px: the inputs are now 38px tall (InputHeight), so
                         the old 36px rows would squeeze them by 2px. -->
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="تاریخ واریز:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DateBox" TabIndex="1" VerticalContentAlignment="Center" Padding="6,0"
                         FontSize="{DynamicResource FontSize}" ToolTip="مثال: 1404/07/10"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="مبلغ واریز:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="0" Grid.Column="4" x:Name="AmountBox" TabIndex="2" VerticalContentAlignment="Center" Padding="6,0"
                         FontSize="{DynamicResource FontSize}" ToolTip="مثال: 23,158,293"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="توضیح تغییرات:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" x:Name="ChangesBox" TabIndex="3" VerticalContentAlignment="Center" Padding="6,0"
                         FontSize="{DynamicResource FontSize}" IsReadOnly="True" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="10,6" Margin="0,0,0,8" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="AdvanceCheck" Content="واریزی علی‌الحساب" TabIndex="4" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" ToolTip="این واریز، علی‌الحساب هست و هنوز تسویه نشده."
                              Checked="AdvanceCheck_Changed" Unchecked="AdvanceCheck_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="AdvanceHint" Text="• مرتبط با ردیف‌های تایید شده دارای تاریخ شروع" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource LabelFontSize}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSmall}" Padding="8" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="RelatedHeader" Text="تاریخ‌های مرتبط (ستون آغاز — فقط پرداخت شده):" FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource TextBrush}" ToolTip="این واریز به کدام ردیف‌های حق‌الزحمه تاییدشده وصل هست."/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="180">
                        <StackPanel x:Name="EndDatePanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                <Button Content="✓ _تایید" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource OnSuccessBrush}" FontWeight="Bold" Margin="0,0,8,0" Click="Ok_Click" TabIndex="5"/>
                <Button Content="✕ _انصراف" Background="{DynamicResource TextSecondaryBrush}" Foreground="{DynamicResource OnSecondaryBrush}" Click="Cancel_Click" TabIndex="6"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
