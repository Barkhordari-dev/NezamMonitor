<UserControl
             xmlns:local="clr-namespace:NezamMonitorPro.App.Converters" x:Class="NezamMonitorPro.App.Views.FeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="💰 حق‌الزحمه" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="💰 حق‌الزحمه" Margin="0,0,6,0"
                        FontSize="{DynamicResource FontSize}" FontWeight="Bold" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Click="TabFee_Click" x:Name="BtnTabFee" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"/>
                <Button Content="📥 دریافتی"
                        FontSize="{DynamicResource FontSize}" FontWeight="Bold" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Click="TabReceipt_Click" x:Name="BtnTabReceipt" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" x:Name="PanelFees">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SuccessBrush}" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="پرداخت شده" Foreground="{DynamicResource OnSuccessBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PaidAmount}" Foreground="{DynamicResource OnSuccessBrush}" FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PaidCount, StringFormat='{}{0} مورد'}" Foreground="{DynamicResource OnSuccessBrush}" Opacity="0.85" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="8" Padding="10" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="تایید شده" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfirmedAmount}" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ConfirmedCount, StringFormat='{}{0} مورد'}" Foreground="{DynamicResource OnPrimaryBrush}" Opacity="0.85" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource WarningBrush}" CornerRadius="8" Padding="10" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="در انتظار" Foreground="{DynamicResource OnWarningBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PendingAmount}" Foreground="{DynamicResource OnWarningBrush}" FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PendingCount, StringFormat='{}{0} مورد'}" Foreground="{DynamicResource OnWarningBrush}" Opacity="0.85" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="کل" Foreground="{DynamicResource OnAccentBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalAmount}" Foreground="{DynamicResource OnAccentBrush}" FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} مورد'}" Foreground="{DynamicResource OnAccentBrush}" Opacity="0.85" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍 جستجو:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="5,0" FontSize="{DynamicResource InputFontSize}" local:Watermark.Text="جستجو در پروندهها..." />
                    <TextBlock Grid.Column="3" Text="مالک:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding OwnerFilters}" SelectedItem="{Binding FilterOwner}" Height="34" Margin="5,0" FontSize="{DynamicResource InputFontSize}" IsEditable="True" StaysOpenOnEdit="True"/>
                    <TextBlock Grid.Column="6" Text="شماره پرونده:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <ComboBox Grid.Column="7" ItemsSource="{Binding CaseNumberFilters}" SelectedItem="{Binding FilterCaseNumber}" Height="34" Margin="5,0" FontSize="{DynamicResource InputFontSize}" IsEditable="True" StaysOpenOnEdit="True"/>
                    <TextBlock Grid.Column="9" Text="رشته:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <ComboBox Grid.Column="10" ItemsSource="{Binding DisciplineFilters}" SelectedItem="{Binding FilterDiscipline}" Height="34" Margin="5,0" FontSize="{DynamicResource InputFontSize}"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="وضعیت:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Height="34" Margin="5,0" FontSize="{DynamicResource InputFontSize}"/>
                    <TextBlock Grid.Column="3" Text="مرحله:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding StageFilters}" SelectedItem="{Binding FilterStage}" Height="34" Margin="5,0" FontSize="{DynamicResource InputFontSize}"/>
                    <TextBlock Grid.Column="6" Text="نوع خدمت:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <ComboBox Grid.Column="7" ItemsSource="{Binding ServiceTypeFilters}" SelectedItem="{Binding FilterServiceType}" Height="34" Margin="5,0" FontSize="{DynamicResource InputFontSize}" IsEditable="True" StaysOpenOnEdit="True"/>
                    <TextBlock Grid.Column="9" Text="مبلغ از:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <TextBox Grid.Column="10" Text="{Binding FilterAmountFrom, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="5,0" FontSize="{DynamicResource InputFontSize}"/>
                    <TextBlock Grid.Column="12" Text="تا:" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                    <TextBox Grid.Column="13" Text="{Binding FilterAmountTo, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="5,0" FontSize="{DynamicResource InputFontSize}"/>
                    <Button Grid.Column="15" Content="🧹 پاک کردن فیلترها" Command="{Binding ClearFiltersCommand}"
                            Padding="10,0" Background="{DynamicResource ErrorBrush}" Foreground="{DynamicResource OnErrorBrush}"
                            FontSize="12" FontWeight="Bold"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisConverter}}"/>
                    <TextBlock Grid.Column="17" Text="{Binding CountDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource LabelFontSize}" FontWeight="Bold"/>
                </Grid>
            </Border>
            <DataGrid Grid.Row="3" x:Name="FeesGrid" ItemsSource="{Binding Fees}" AutoGenerateColumns="False"
                      AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                      CanUserSortColumns="True" FontSize="{DynamicResource FontSize}"
                      PreviewMouseLeftButtonDown="FeesGrid_PreviewMouseLeftButtonDown"
                      MouseRightButtonUp="FeesGrid_MouseRightButtonUp" FlowDirection="{DynamicResource TableFlowDirection}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="انتخاب" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="95" CanUserSort="False"/>
                    <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" SortMemberPath="CaseNumber" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" SortMemberPath="Owner" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="رشته" Binding="{Binding Discipline}" SortMemberPath="Discipline" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="نوع خدمت" Binding="{Binding ServiceType}" SortMemberPath="ServiceType" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="مرحله" Binding="{Binding Stage}" SortMemberPath="Stage" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="مبلغ" Binding="{Binding AmountDisplay}" SortMemberPath="AmountValue" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="وضعیت" Binding="{Binding PayStatus}" SortMemberPath="PayStatus" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="تایید" Binding="{Binding ConfirmStatus}" SortMemberPath="ConfirmStatus" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="شروع" Binding="{Binding StartDate}" SortMemberPath="StartDate" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="پایان" Binding="{Binding EndDate}" SortMemberPath="EndDate" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="توضیحات" Binding="{Binding Description}" SortMemberPath="Description" Width="*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,5,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="انتخاب شده:" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="{Binding SelectedCount}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" Margin="0,0,5,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="مورد | جمع:" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="{Binding SelectedAmount}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
        </Grid>
        <Grid Grid.Row="1" x:Name="PanelReceipts" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="➕ افزودن" Command="{Binding AddReceiptCommand}" Padding="12,0" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource OnSuccessBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="✏️ ویرایش" Padding="12,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,6,0" Click="ReceiptEdit_Click"/>
                    <Button Grid.Column="2" Content="🗑 حذف" Padding="12,0" Background="{DynamicResource ErrorBrush}" Foreground="{DynamicResource OnErrorBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,6,0" Click="ReceiptDelete_Click"/>
                    <Button Grid.Column="3" Content="🔄 بروزرسانی" Command="{Binding UpdateReceiptsCommand}" Padding="12,0" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource OnWarningBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,6,0" ToolTip="حق‌الزحمه‌های تغییرکرده را محاسبه و ردیف‌های متاثر را سبز می‌کند"/>
                    <Button Grid.Column="4" Content="📤 خروجی اکسل" Command="{Binding ExportReceiptsCommand}" Padding="12,0" Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="{DynamicResource FontSize}" Margin="0,0,6,0"/>
                    <Button Grid.Column="5" Content="📥 ورودی اکسل" Command="{Binding ImportReceiptsCommand}" Padding="12,0" Background="#7D3C98" Foreground="White" FontSize="{DynamicResource FontSize}" Margin="0,0,6,0"/>
                    <Button Grid.Column="6" Content="🔄 بارگذاری" Command="{Binding RefreshReceiptsCommand}" Padding="12,0" Background="{DynamicResource TextSecondaryBrush}" Foreground="{DynamicResource OnSecondaryBrush}" FontSize="{DynamicResource FontSize}"/>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="🔍 جستجو:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ReceiptSearch, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="34" VerticalContentAlignment="Center" Padding="6,0" FontSize="{DynamicResource FontSize}" local:Watermark.Text="جستجو در رسیدها..." />
                    </StackPanel>
                    <TextBlock Grid.Column="8" Text="{Binding ReceiptStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}" Margin="10,0,0,0"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="8" Padding="12" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="جمع واریزی" Foreground="{DynamicResource SidebarTextBrush}" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ReceiptTotalAmount}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#2E86C1" CornerRadius="8" Padding="12" Margin="5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="جمع حق‌الزحمه مرتبط" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ReceiptTotalFeeSum}" Foreground="White" FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#117A65" CornerRadius="8" Padding="12" Margin="5,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="جمع اختلاف" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ReceiptTotalDiff}" Foreground="White" FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataGrid Grid.Row="2" x:Name="ReceiptsGrid" ItemsSource="{Binding Receipts}" AutoGenerateColumns="False"
                      IsReadOnly="False" SelectionMode="Single" SelectionUnit="FullRow"
                      AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                      CanUserSortColumns="True" FontSize="{DynamicResource FontSize}"
                      PreviewMouseLeftButtonDown="ReceiptsGrid_PreviewMouseLeftButtonDown"
                      MouseDoubleClick="ReceiptsGrid_DoubleClick"
                      FlowDirection="{DynamicResource TableFlowDirection}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecentlyUpdated}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="انتخاب" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="95" CanUserSort="False"/>
                    <DataGridTextColumn Header="نوع" Binding="{Binding TypeDisplay}" SortMemberPath="IsAdvance" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="B Nazanin"/>
                                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdvance}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="تاریخ واریز" Binding="{Binding ReceiptDate}" SortMemberPath="ReceiptDate" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="مبلغ واریز" Binding="{Binding AmountDisplay}" SortMemberPath="Amount" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="تاریخ‌های مرتبط (آغاز)" Binding="{Binding RelatedDisplay}" SortMemberPath="RelatedDisplay" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="جمع حق‌الزحمه" Binding="{Binding FeeSumDisplay}" SortMemberPath="FeeSum" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn Header="اختلاف" Binding="{Binding DifferenceDisplay}" SortMemberPath="Difference" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="B Nazanin"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="تغییرات" Binding="{Binding Changes}" SortMemberPath="Changes" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,5,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="انتخاب شده:" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="{Binding ReceiptSelectedCount}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" Margin="0,0,5,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="مورد | جمع واریز:" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="{Binding ReceiptSelectedAmount}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="Bold" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="جمع حق‌الزحمه:" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="{Binding ReceiptSelectedFeeSum}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="اختلاف:" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"/>
                    <TextBlock Text="{Binding ReceiptSelectedDiff}" Foreground="{DynamicResource ErrorTextBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="4" Text="💡 نکته: ردیف سبز = بعد از آخرین بروزرسانی تغییر کرده | اختلاف منفی = قرمز | کلیک روی هر ردیف = انتخاب | دابل‌کلیک = ویرایش" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="5" Text="{Binding ReceiptStatus}" Foreground="{DynamicResource SuccessTextBrush}" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}" Margin="0,4,0,0"/>
        </Grid>
    </Grid>
</UserControl>
