<UserControl x:Class="NezamMonitorPro.App.Views.UpdateView" FlowDirection="{DynamicResource MainWindowFlowDirection}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:srv="clr-namespace:NezamMonitorPro.App.Services"
             xmlns:api="clr-namespace:NezamMonitorPro.Core.Api;assembly=NezamMonitorPro.Core"
             PreviewKeyDown="UpdateView_PreviewKeyDown" PreviewKeyUp="UpdateView_PreviewKeyUp">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Animations.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ Card: the main container ═══ -->
            <Style x:Key="SoftCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#0B1B33"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Card header (icon + title) ═══ -->
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ═══ Field label ═══ -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- ═══ Text field (soft, rounded, clear focus ring) ═══
                 NOTE on the template: the ScrollViewer must NOT be pinned to
                 VerticalAlignment="Center" and must not reserve space for a
                 vertical scrollbar. Either one makes the Persian text look
                 vertically trimmed inside the box. -->
            <Style x:Key="SoftTextBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- NOTE: a PasswordBox style cannot be BasedOn a TextBox style in WPF,
                 so this one is defined standalone. Same ScrollViewer rules as
                 SoftTextBox above (no vertical scrollbar gutter, no Center pin)
                 otherwise the text gets clipped inside the box. -->
            <Style x:Key="SoftPasswordBox" TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0,38,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              Focusable="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="bd" Property="BorderThickness" Value="1.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Checkbox: bigger, easier to click ═══ -->
            <Style x:Key="SoftCheckBox" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="21" Height="21" CornerRadius="6"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1.4" VerticalAlignment="Center">
                                    <Path x:Name="tick" Data="M 2,6 L 5.5,9.5 L 11,3.5"
                                          Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                                          StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                          Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Radio button: bigger, easier to click ═══ -->
            <Style x:Key="SoftRadio" TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Margin" Value="0,0,18,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="21" Height="21" VerticalAlignment="Center">
                                    <Ellipse x:Name="ring" Width="19" Height="19"
                                             Fill="{DynamicResource InputBackgroundBrush}"
                                             Stroke="{DynamicResource InputBorderBrush}" StrokeThickness="1.4"/>
                                    <Ellipse x:Name="dot" Width="9" Height="9"
                                             Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Action buttons ═══ -->
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ProButtonBase}">
                <Setter Property="Height" Value="42"/>
                <Setter Property="MinWidth" Value="150"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OutlineAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1.4" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- ════════════ STATUS CARD (replaces the raw API log) ════════════ -->
            <Border x:Name="StatusCard" Style="{StaticResource SoftCard}" Margin="0,0,0,16">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="StatusCardTranslate"/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Animated icon -->
                    <Grid Grid.Column="0" Width="62" Height="62" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Border x:Name="IconCircle" Width="62" Height="62" CornerRadius="31"
                                Background="{DynamicResource PanelBrush}">
                            <Grid>
                                <!-- spinning ring (connecting) -->
                                <Ellipse x:Name="SpinRing" Width="52" Height="52" StrokeThickness="2.5"
                                         Stroke="{DynamicResource PrimaryBrush}"
                                         StrokeDashArray="3 4" Visibility="Collapsed"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinRotate"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <!-- cloud with download arrow -->
                                <Grid x:Name="CloudIcon" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="CloudScale"/>
                                    </Grid.RenderTransform>
                                    <Path Data="M 5,22 A 7,7 0 0 1 6,8.5 A 9.5,9.5 0 0 1 24,10.5 A 6.5,6.5 0 0 1 25,22 Z"
                                          Fill="{DynamicResource PrimaryBrush}" Opacity="0.16"/>
                                    <Path Data="M 5,22 A 7,7 0 0 1 6,8.5 A 9.5,9.5 0 0 1 24,10.5 A 6.5,6.5 0 0 1 25,22 Z"
                                          Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round"/>
                                    <Grid x:Name="ArrowGroup" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="ArrowTranslate" Y="0"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Path Data="M 15,12 L 15,21 M 11,17 L 15,21 L 19,17"
                                              Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                                              StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                    </Grid>
                                </Grid>

                                <!-- success check -->
                                <Path x:Name="SuccessTick" Data="M 8,17 L 13,22 L 22,11"
                                      Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.6"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="SuccessScale" ScaleX="0.4" ScaleY="0.4"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Friendly messages -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" Text="آماده برای شروع"
                                   FontFamily="{DynamicResource HeadingFontFamily}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusDetail" Text=""
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <!-- Progress bar (thick, rounded) -->
                        <Grid x:Name="ProgressRow" Margin="0,12,0,0" Visibility="Collapsed" ToolTip="استخراج در چه مرحله‌ای هست و چند پرونده از چند تا انجام شده.">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="12" CornerRadius="6"
                                    Background="{DynamicResource PanelBrush}" ClipToBounds="True">
                                <Grid x:Name="ProgressTrack">
                                    <Rectangle x:Name="ProgressFill" RadiusX="6" RadiusY="6"
                                               HorizontalAlignment="Left" Width="0"
                                               Fill="{DynamicResource PrimaryBrush}"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ProgressCount" Grid.Row="1" Text=""
                                       FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Big count on the right -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="14"
                        Padding="18,10" VerticalAlignment="Center" MinWidth="110"
                        x:Name="CountBadge">
                    <StackPanel>
                        <TextBlock x:Name="BigCount" Text="" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="پرونده" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
                </Grid>
            </Border>

            <!-- ════════════ 1. Login ════════════ -->
            <!-- S-003: هنگام اجرا، کل کارت ورود قفل می‌شود (نه فقط دکمه‌ها). -->
            <Border x:Name="LoginCard" Style="{StaticResource SoftCard}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}, Source={x:Static srv:ExtractionController.Instance}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A2563EB" Margin="0,0,10,0">
                            <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="اطلاعات ورود به سامانه" Style="{StaticResource CardTitle}" ToolTip="نام کاربری و رمز عبورت در سامانه نظام مهندسی؛ بدون این، داده‌ای گرفته نمی‌شه."/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="نام کاربری" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                            <TextBox x:Name="UsernameBox" Style="{StaticResource SoftTextBox}" ToolTip="شماره عضویتت در سامانه."
                                     FlowDirection="LeftToRight"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                            <Grid>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource SoftPasswordBox}" ToolTip="رمز ورودت به سامانه؛ با چشم کنارش می‌تونی ببینیش."
                                             FlowDirection="LeftToRight"
                                             PasswordChanged="PasswordBox_PasswordChanged"/>
                                <TextBox x:Name="VisiblePasswordBox" Style="{StaticResource SoftTextBox}"
                                         FlowDirection="LeftToRight"
                                         Padding="12,0,38,0" TextChanged="VisiblePasswordBox_TextChanged"
                                         Visibility="Collapsed"/>
                                <ToggleButton x:Name="ShowPasswordToggle" Width="30" Height="30" HorizontalAlignment="Right"
                                              Style="{StaticResource EyeButtonStyle}" Click="TogglePassword_Click"
                                              ToolTip="نمایش یا پنهان کردن رمزی که نوشته‌ای."/>
                            </Grid>
                            <!-- S-027: هشدار Caps Lock، مثل پنجره رمز برنامه. -->
                            <TextBlock x:Name="CapsWarning" Text="⚠ قفل Caps Lock روشن است؛ رمز را با حروف درست بنویس."
                                       Foreground="{DynamicResource WarningTextBrush}" FontSize="12"
                                       Margin="0,6,0,0" Visibility="Collapsed" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- SEC-002: اتصال به سامانه رمزنگاری نشده است (HTTP). -->
                    <TextBlock Text="{x:Static api:NezamApiClient.InsecureConnectionWarning}"
                               Foreground="{DynamicResource WarningTextBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,14,0,0"/>

                    <CheckBox Content="ذخیره اطلاعات ورود" Style="{StaticResource SoftCheckBox}" ToolTip="اگه تیک بخوره، دفعه بعد نام کاربری و رمز رو دوباره نمی‌خواد."
                              IsChecked="{Binding RememberMe}" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- ════════════ 2. Extraction options ════════════ -->
            <!-- S-003: هنگام اجرا، کل کارت گزینه‌ها قفل می‌شود (نه فقط دکمه‌ها). -->
            <Border x:Name="OptionsCard" Style="{StaticResource SoftCard}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}, Source={x:Static srv:ExtractionController.Instance}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1AF59E0B" Margin="0,0,10,0">
                            <TextBlock Text="&#xE713;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource WarningTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="گزینه‌های استخراج" Style="{StaticResource CardTitle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="شروع از پرونده شماره" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="StartFromBox" Style="{StaticResource SoftTextBox}" Width="110" ToolTip="از کدام پرونده شروع شه؛ ۱ یعنی از اولین پرونده."
                                     Text="{Binding StartFromIndex, UpdateSourceTrigger=PropertyChanged, Source={x:Static srv:ExtractionController.Instance}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Text="تعداد" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="MaxCasesBox" Style="{StaticResource SoftTextBox}" Width="110" ToolTip="چند پرونده گرفته شه؛ صفر یعنی همه پرونده‌ها."
                                     Text="{Binding MaxCases, UpdateSourceTrigger=PropertyChanged, Source={x:Static srv:ExtractionController.Instance}}"/>
                        </StackPanel>

                        <!-- S-008: راهنمای عددها، همیشه جلوی چشم. -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,10">
                            <TextBlock Text="شروع: ۱ یعنی از اولین پرونده" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="تعداد: ۰ یعنی همه پرونده‌ها" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="فقط پرونده‌های ناقص (بدون مشخصات / گزارش / ناظرین / حق‌الزحمه)" ToolTip="فقط پرونده‌هایی گرفته می‌شن که مشخصات، گزارش، ناظر یا حق‌الزحمه‌شان ناقص هست."
                              Style="{StaticResource SoftCheckBox}"
                              IsChecked="{Binding FilterIncompleteOnly, Source={x:Static srv:ExtractionController.Instance}}"
                              Margin="0,18,0,0"/>

                    <!-- S-009: چه چیزهایی گرفته بشن (قبلا فقط در کنترلر بود، در صفحه نبود). -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <TextBlock Text="گرفتن چی‌ها" Style="{StaticResource FieldLabel}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <CheckBox Content="مهندسین" Style="{StaticResource SoftCheckBox}" Margin="0,0,18,0"
                                  ToolTip="مهندسین ناظر هر پرونده هم گرفته بشن."
                                  IsChecked="{Binding ExtractEngineers, Source={x:Static srv:ExtractionController.Instance}}"/>
                        <CheckBox Content="حق‌الزحمه" Style="{StaticResource SoftCheckBox}" Margin="0,0,18,0"
                                  ToolTip="حق‌الزحمه هر پرونده هم گرفته بشه."
                                  IsChecked="{Binding ExtractFees, Source={x:Static srv:ExtractionController.Instance}}"/>
                        <CheckBox Content="گزارش‌ها" Style="{StaticResource SoftCheckBox}"
                                  ToolTip="گزارش‌های هر پرونده هم گرفته بشن."
                                  IsChecked="{Binding ExtractReports, Source={x:Static srv:ExtractionController.Instance}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding ExtractSpecifications, Converter={StaticResource BoolToVisConverter}, Source={x:Static srv:ExtractionController.Instance}}">
                        <TextBlock Text="حالت مشخصات" Style="{StaticResource FieldLabel}" Margin="0,0,14,0"
                                   VerticalAlignment="Center"/>
                        <RadioButton Content="فقط ناقص" Style="{StaticResource SoftRadio}" GroupName="SpecMode" ToolTip="فقط ناقص یعنی پرونده‌های کامل دست نمی‌خورن؛ بازنویسی کامل یعنی همه از اول گرفته می‌شن."
                                     IsChecked="{Binding UpdateAllSpecifications, Converter={StaticResource InverseBoolConverter}, Source={x:Static srv:ExtractionController.Instance}}"/>
                        <RadioButton Content="بازنویسی کامل" Style="{StaticResource SoftRadio}" GroupName="SpecMode" ToolTip="همه پرونده‌ها از اول گرفته می‌شن؛ پرونده‌های کامل هم بازنویسی می‌شن."
                                     IsChecked="{Binding UpdateAllSpecifications, Source={x:Static srv:ExtractionController.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════ 3. File options ════════════ -->
            <!-- S-003: هنگام اجرا، کل کارت فایل قفل می‌شود (نه فقط دکمه‌ها). -->
            <Border x:Name="FileCard" Style="{StaticResource SoftCard}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}, Source={x:Static srv:ExtractionController.Instance}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A7C3AED" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="گزینه‌های فایل" Style="{StaticResource CardTitle}"/>
                    </StackPanel>

                    <TextBlock Text="مسیر ذخیره فایل‌ها" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputPathBox" Grid.Column="0" Style="{StaticResource SoftTextBox}" ToolTip="پوشه‌ای که فایل‌های گزارش و پیوست‌ها در آن ذخیره می‌شن."
                                 FontFamily="{StaticResource PathFontFamily}" FlowDirection="LeftToRight" TextAlignment="Left"
                                 Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged, Source={x:Static srv:ExtractionController.Instance}}"/>
                        <Button Grid.Column="1" Content="انتخاب پوشه" Style="{StaticResource OutlineAction}"
                                Click="BtnBrowseOutput_Click" Margin="10,0,0,0" MinWidth="120"/>
                    </Grid>

                    <CheckBox Content="دریافت فایل‌های پیوست گزارش" Style="{StaticResource SoftCheckBox}" ToolTip="تصویر گزارش‌های سامانه هم دانلود و کنار پرونده ذخیره می‌شه."
                              IsChecked="{Binding ExtractReportFiles, Source={x:Static srv:ExtractionController.Instance}}"
                              Margin="0,18,0,0"/>

                    <CheckBox Content="رد کردن فایل‌های موجود با حجم یکسان (سریع‌تر)" ToolTip="فایلی که قبلا با همان حجم دانلود شده، دوباره دانلود نمی‌شه؛ سریع‌تر تمام می‌شه."
                              Style="{StaticResource SoftCheckBox}"
                              IsChecked="{Binding SkipExistingReportFiles, Source={x:Static srv:ExtractionController.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- ════════════ 4. Action buttons ════════════ -->
            <Border Style="{StaticResource SoftCard}">
                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="BtnStart" Style="{StaticResource PrimaryAction}" Click="BtnStart_Click" ToolTip="شروع گرفتن داده‌ها از سامانه."
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- icon on the right of the label (RTL convention) -->
                            <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFontFamily}" FontSize="{DynamicResource FontSize}"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="شروع همگام سازی" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnStop" Style="{StaticResource OutlineAction}" Click="BtnStop_Click" ToolTip="توقف استخراج در میانه کار."
                            Margin="0,0,10,0" MinWidth="120">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE769;" FontFamily="{DynamicResource IconFontFamily}" FontSize="{DynamicResource FontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="توقف" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnLoad" Style="{StaticResource SecondaryAction}" Click="BtnLoad_Click" MinWidth="150" ToolTip="نمایش آخرین داده‌هایی که قبلا گرفته شده، بدون اتصال به سامانه.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{DynamicResource IconFontFamily}" FontSize="{DynamicResource FontSize}"
                                       Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="نمایش آخرین داده‌های ذخیره‌شده" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
