<Window x:Class="NezamMonitorPro.App.Views.HiddenPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="منوی مخفی"
        Width="460" Height="380"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- First-time setup: the hidden-menu Drive folder id (asked once). -->
        <StackPanel x:Name="SetupPanel" Grid.Row="0" Visibility="Collapsed">
            <TextBlock Text="🔒 راه‌اندازی منوی مخفی" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="شناسه پوشه درایو را وارد کن؛ لینک کامل پوشه هم قبول است."
                       FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="FolderIdBox" Margin="0,12,0,0" Height="36" VerticalContentAlignment="Center"
                     FontFamily="{StaticResource PathFontFamily}" FlowDirection="LeftToRight"/>
            <Button x:Name="SaveFolderButton" Content="💾 _ذخیره و بررسی" Click="SaveFolderButton_Click"
                    Margin="0,12,0,0" HorizontalAlignment="Right" MinWidth="140"/>
            <TextBlock x:Name="SetupErrorText" Foreground="{DynamicResource ErrorTextBrush}"
                       FontSize="{DynamicResource LabelFontSize}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ProgressBar x:Name="SetupCheckingBar" IsIndeterminate="True" Height="6"
                         Visibility="Collapsed" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Password prompt. -->
        <StackPanel x:Name="PasswordPanel" Grid.Row="0">
            <TextBlock Text="🔒 منوی مخفی" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center"
                             FontFamily="{StaticResource PathFontFamily}" FlowDirection="LeftToRight"/>
                <TextBox x:Name="VisiblePasswordBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center"
                         Visibility="Collapsed" FontFamily="{StaticResource PathFontFamily}" FlowDirection="LeftToRight"/>
                <!-- چشم + برچسب متنی «نمایش/پنهان»؛ برچسب همیشه دیده می‌شود تا دکمه از چشم نیفتد. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ToggleButton x:Name="ShowPasswordToggle" Width="34" Height="30"
                                  Style="{StaticResource EyeButtonStyle}"
                                  Checked="ShowPasswordToggle_Checked" Unchecked="ShowPasswordToggle_Unchecked"/>
                    <TextBlock x:Name="ShowPasswordLabel" Text="نمایش" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                               MouseLeftButtonUp="ShowPasswordLabel_Click"/>
                </StackPanel>
            </Grid>
            <!-- S-027: هشدار Caps Lock، مثل پنجره رمز برنامه. -->
            <TextBlock x:Name="CapsWarning" Visibility="Collapsed"
                       Text="⚠  Caps Lock روشن است" ToolTip="کلید Caps Lock روشن هست؛ رمز رو با حروف بزرگ می‌نویسی."
                       FontSize="11.5" Foreground="{DynamicResource WarningTextBrush}"
                       Margin="0,8,0,0"/>
            <TextBlock x:Name="InfoText" Visibility="Collapsed" Foreground="{DynamicResource SuccessBrush}"
                       FontSize="{DynamicResource LabelFontSize}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}"
                       FontSize="{DynamicResource LabelFontSize}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <ProgressBar x:Name="CheckingBar" IsIndeterminate="True" Height="6"
                         Visibility="Collapsed" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" Content="_تایید" Click="ConfirmButton_Click" MinWidth="100" IsDefault="True"/>
            <Button Content="_انصراف" Click="CancelButton_Click" Margin="8,0,0,0" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
