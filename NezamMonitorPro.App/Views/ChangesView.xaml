<UserControl x:Class="NezamMonitorPro.App.Views.ChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📈 مقایسه اسنپ‌شات‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="از:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Snapshots}" SelectedValue="{Binding FromSnapshotId}"
                      SelectedValuePath="Id" MinWidth="340" Margin="5,0" FontSize="{DynamicResource FontSize}"
                      ToolTip="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource Self}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="تا:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="15,0,0,0"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Snapshots}" SelectedValue="{Binding ToSnapshotId}"
                      SelectedValuePath="Id" MinWidth="340" Margin="5,0" FontSize="{DynamicResource FontSize}"
                      ToolTip="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource Self}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Button Grid.Row="2" Content="🔍 مقایسه" Command="{Binding CompareCommand}"
                MinWidth="120" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                FontWeight="Bold" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Changes}" AutoGenerateColumns="False"
                  IsReadOnly="True" AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FlowDirection="{DynamicResource TableFlowDirection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="نوع" Binding="{Binding ChangeType}" Width="Auto" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
                <DataGridTextColumn Header="فیلد" Binding="{Binding Field}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="مقدار قبلی" Binding="{Binding OldValue}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="مقدار جدید" Binding="{Binding NewValue}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,0" FontSize="{DynamicResource LabelFontSize}"/>
        </StackPanel>
    </Grid>
</UserControl>
