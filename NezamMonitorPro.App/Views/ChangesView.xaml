<UserControl x:Class="NezamMonitorPro.App.Views.ChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📈 مقایسه اسنپ‌شات‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Two 340px-min pickers side by side are ~760px wide and overflow
             a 1024×768 content area (~746px) — the centred row was clipped
             on both sides. The pickers now stretch (* columns) instead. -->
        <Grid Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="از:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}" ToolTip="دو اسنپ‌شات که می‌خوای با هم مقایسه شن."/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Snapshots}" SelectedValue="{Binding FromSnapshotId}"
                      SelectedValuePath="Id" MinWidth="200" Margin="5,0" FontSize="{DynamicResource FontSize}" TabIndex="1"
                      ToolTip="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource Self}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="تا:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="15,0,0,0" ToolTip="دو اسنپ‌شات که می‌خوای با هم مقایسه شن."/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Snapshots}" SelectedValue="{Binding ToSnapshotId}"
                      SelectedValuePath="Id" MinWidth="200" Margin="5,0" FontSize="{DynamicResource FontSize}" TabIndex="2"
                      ToolTip="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource Self}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Button Grid.Row="2" Content="🔍 _مقایسه" Command="{Binding CompareCommand}" ToolTip="مقایسه دو اسنپ‌شات و نشان دادن تغییر هر پرونده."
                MinWidth="120" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                FontWeight="Bold" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,0,10" TabIndex="3"/>

        <!-- Read-only snapshot viewer (P3) -->
        <Grid Grid.Row="3" Margin="0,0,0,10" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="مشاهده اسنپ‌شات:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}" ToolTip="انتخاب یک اسنپ‌شات برای دیدن محتوایش."/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Snapshots}" SelectedValue="{Binding ViewSnapshotId}"
                      SelectedValuePath="Id" MinWidth="200" Margin="5,0" FontSize="{DynamicResource FontSize}" TabIndex="4"
                      ToolTip="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource Self}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="👁 _مشاهده (فقط‌خواندنی)" Command="{Binding ViewSnapshotCommand}" ToolTip="باز کردن اسنپ‌شات برای دیدن، بدون اینکه چیزی عوض شه."
                    MinWidth="160" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"
                    FontWeight="Bold" FontSize="{DynamicResource ButtonFontSize}" TabIndex="5"/>
        </Grid>

        <!-- G-020: متن حالت خالی وقتی مقایسه انجام شده و هیچ تغییری نیست. -->
        <Grid Grid.Row="4">
            <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Changes}" AutoGenerateColumns="False"
                      IsReadOnly="True" AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" FlowDirection="{DynamicResource TableFlowDirection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Binding="{Binding ChangeType}" Width="Auto" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}">
                <DataGridTextColumn.Header>
                    <TextBlock Text="نوع" ToolTip="نوع تغییر (اضافه، حذف یا ویرایش)."/>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Field}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}">
                <DataGridTextColumn.Header>
                    <TextBlock Text="فیلد" ToolTip="کدام فیلد پرونده عوض شده (مثلا مالک یا آدرس)."/>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding OldValue}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}">
                <DataGridTextColumn.Header>
                    <TextBlock Text="مقدار قبلی" ToolTip="مقدار فیلد قبل و بعد از تغییر."/>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding NewValue}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}">
                <DataGridTextColumn.Header>
                    <TextBlock Text="مقدار جدید" ToolTip="مقدار فیلد قبل و بعد از تغییر."/>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
            <TextBlock Text="هیچ تغییری بین این دو اسنپ‌شات نیست — هر دو نسخه یکی‌اند."
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextSecondaryBrush}"
                       Visibility="{Binding HasNoChanges, Converter={StaticResource BoolToVisConverter}}"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,0" FontSize="{DynamicResource LabelFontSize}"/>
        </StackPanel>
    </Grid>
</UserControl>
