<Window x:Class="NezamMonitorPro.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورود به سیستم"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="Transparent"
        FontFamily="{DynamicResource FontFamily}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <!-- رمز: کادر مدرن با دکمهٔ نمایش رمز بیرون از قالب -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="16,0,54,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="16,0,54,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevealToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ToolTip" Value="نمایش / مخفی کردن رمز"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ProButton}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ProButtonGhost}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- پردهٔ تاریک پشت کارت -->
        <Border Background="#B3050B18"/>

        <Border Margin="28"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Effect="{DynamicResource CardShadowEffect}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="24"/>
            </Border.RenderTransform>
            <Border CornerRadius="24" ClipToBounds="True" x:Name="MainCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ═══ هدر گرادیانی ═══ -->
                    <Border Grid.Row="0" Padding="26,22" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="16"
                                    Background="#33FFFFFF" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="&#xE72E;"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="26" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ورود به نسخه پرو" FontSize="21" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock x:Name="SubtitleText"
                                           Text="برای باز کردن پایگاه دادهٔ رمزنگاری‌شده، رمز عبور را وارد کنید."
                                           FontSize="12.5" Foreground="#DCE7FF"
                                           Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>

                            <Button Grid.Column="2" x:Name="CloseButton" Width="34" Height="34"
                                    Padding="0" Background="#22FFFFFF" BorderThickness="0"
                                    Cursor="Hand" ToolTip="بستن" Click="CloseButton_Click"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource ProIconButton}">
                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="{DynamicResource FontSize}" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- ═══ بدنه ═══ -->
                    <StackPanel Grid.Row="1" Margin="28,24,28,26">

                        <TextBlock Text="رمز عبور" FontSize="{DynamicResource LabelFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="2,0,0,8"/>

                        <Grid>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"
                                         KeyDown="PasswordBox_KeyDown"/>
                            <TextBox x:Name="PasswordTextBox" Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" KeyDown="PasswordBox_KeyDown"/>

                            <ToggleButton x:Name="RevealToggle" Style="{StaticResource RevealToggle}"
                                          HorizontalAlignment="Left" Margin="8,0,0,0"
                                          Click="RevealToggle_Click">
                                <TextBlock x:Name="RevealIcon" Text="&#xE7B3;"
                                           FontFamily="{DynamicResource IconFontFamily}" FontSize="17"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <TextBlock x:Name="CapsWarning" Visibility="Collapsed"
                                   Text="⚠  Caps Lock روشن است"
                                   FontSize="11.5" Foreground="{DynamicResource WarningTextBrush}"
                                   Margin="2,8,0,0"/>

                        <TextBlock x:Name="ErrorText" Text="" FontSize="12.5"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   Margin="2,10,0,0" TextWrapping="Wrap" LineHeight="18"/>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="اطلاعات شما به‌صورت محلی و رمزنگاری‌شده نگهداری می‌شود."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="190"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CancelButton" Content="انصراف"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="CancelButton_Click" Margin="0,0,10,0"/>
                                <Button x:Name="LoginButton" Content="ورود  ←"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="LoginButton_Click" IsDefault="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
