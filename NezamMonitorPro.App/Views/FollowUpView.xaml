<UserControl
             xmlns:local="clr-namespace:NezamMonitorPro.App.Converters" x:Class="NezamMonitorPro.App.Views.FollowUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NezamMonitorPro.App.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ReportCountConverter x:Key="ReportCountConverter"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر -->
        <TextBlock Grid.Row="0" Text="📋 پیگیری پرونده‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- پنل فیلتر: WrapPanel تا روی صفحه‌های باریک (مثلا 1024×768) دکمه‌ها
             به خط بعد بروند، به‌جای اینکه از لبه صفحه بیرون بیفتند و دیده نشوند. -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="12" Margin="0,0,0,15"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                    <TextBlock Text="🔍 جستجو:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="جستجو با نام مالک یا شماره پرونده."
                             Width="240" FontSize="{DynamicResource InputFontSize}" VerticalContentAlignment="Center" Padding="5" TabIndex="1" local:Watermark.Text="جستجو در پرونده‌ها..." />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                    <TextBlock Text="مالک:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding DistinctOwners}" SelectedItem="{Binding FilterOwner}" ToolTip="فقط پرونده‌های یک مالک رو نشون می‌ده."
                              FontSize="{DynamicResource InputFontSize}" Width="150" TabIndex="2"/>
                </StackPanel>

                <!-- L-015: «اعمال» و «پاک کردن» بلافاصله بعد از فیلترها (قبل از ذخیره). -->
                <Button Content="✔ _اعمال" Command="{Binding ApplyFiltersCommand}" Height="34" ToolTip="فیلترهایی که انتخاب کرده‌ای روی جدول اعمال می‌شه."
                        Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,4" TabIndex="3"/>
                <Button Content="🧹 _پاک کردن" Command="{Binding ClearFiltersCommand}" Height="34" ToolTip="همه‌ی فیلترها پاک می‌شه."
                        Background="{DynamicResource ErrorBrush}" Foreground="{DynamicResource OnErrorBrush}" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,4" TabIndex="4"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisConverter}}"/>
                <TextBlock Text="فیلترهایی که انتخاب کرده‌ای هنوز اعمال نشده‌اند — دکمه «اعمال» را بزن."
                           VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}" Foreground="{DynamicResource WarningTextBrush}"
                           Margin="0,0,5,4" Visibility="{Binding HasPendingFilters, Converter={StaticResource BoolToVisConverter}}"/>

                <Button Content="💾 _ذخیره" Command="{Binding SaveCommand}" Height="34" ToolTip="تغییراتی که در جدول نوشته‌ای ذخیره می‌شه."
                        Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource OnSuccessBrush}" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,4" TabIndex="5"/>
                <Button Content="🔄 _بروزرسانی" Command="{Binding RefreshCommand}" Height="34" ToolTip="جدول پیگیری رو دوباره از پایگاه داده می‌خونه."
                        Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,4" TabIndex="6"/>
                <Button Content="📱 _خروجی مخاطبین" Height="34" ToolTip="ذخیره مالکین به‌صورت فایل مخاطبین (vCard) برای گوشی."
                        Click="ExportVCard_Click"
                        Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,4" TabIndex="7"/>
                <Button Content="📁 _دسته‌بندی بر اساس محدوده" Height="34" ToolTip="ردیف‌ها بر اساس محدوده پرونده گروه‌بندی می‌شن."
                        Command="{Binding GroupByRangeCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,4" TabIndex="8"/>
            </WrapPanel>
        </Border>

        <!-- جدول داده -->
        <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" x:Name="FollowUpGrid" Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                  MouseRightButtonUp="FollowUpGrid_MouseRightButtonUp"
                  CellEditEnding="FollowUpGrid_CellEditEnding" FlowDirection="{DynamicResource TableFlowDirection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ردیف" Binding="{Binding RowId}" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="شماره پرونده" Binding="{Binding CaseNumber, Mode=TwoWay}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCaseNumberModified}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Owner, Mode=TwoWay}" Width="Auto">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="نام مالک" ToolTip="اطلاعاتی که برای پیگیری پرونده و تماس با مالک لازم هست؛ قابل ویرایش هست."/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwnerModified}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Address, Mode=TwoWay}" Width="Auto">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="آدرس" ToolTip="اطلاعاتی که برای پیگیری پرونده و تماس با مالک لازم هست؛ قابل ویرایش هست."/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddressModified}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding OwnerMobile, Mode=TwoWay}" Width="Auto">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="همراه مالک" ToolTip="اطلاعاتی که برای پیگیری پرونده و تماس با مالک لازم هست؛ قابل ویرایش هست."/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwnerMobileModified}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding ReportCount}" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="تعداد گزارش" ToolTip="چند گزارش برای این پرونده ثبت شده."/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReportCount}" Value="0">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ReportCount}" Value="1">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                </DataTrigger>
                                <DataTrigger>
                                    <DataTrigger.Binding>
                                        <Binding Path="ReportCount" Converter="{StaticResource ReportCountConverter}"/>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Description, Mode=TwoWay}" Width="*" MinWidth="120">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="توضیحات" ToolTip="یادداشت آزاد برای این پرونده."/>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextAlignment" Value="{DynamicResource TableTextAlignment}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxHeight" Value="120"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- نوار وضعیت -->
        <TextBlock Grid.Row="3" Text="{Binding CountDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSize}"
                   FontWeight="Bold" Margin="0,5,0,0"/>
    </Grid>
</UserControl>
