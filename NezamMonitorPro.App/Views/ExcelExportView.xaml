<UserControl x:Class="NezamMonitorPro.App.Views.ExcelExportView" FlowDirection="{DynamicResource MainWindowFlowDirection}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📤 خروجی اکسل" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Export folder -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="پوشه خروجی:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" FontSize="{DynamicResource FontSize}"
                       ToolTip="فایل‌های اکسل در این پوشه ساخته می‌شن."/>
            <TextBox Grid.Column="1" Text="{Binding ExportFolder, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource PathTextBoxStyle}"
                     MinWidth="200" VerticalContentAlignment="Center" FontSize="{DynamicResource InputFontSize}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="📁 تغییر پوشه" Command="{Binding BrowseExportFolderCommand}" ToolTip="پوشه‌ای که فایل‌های اکسل در آن ساخته می‌شن را عوض می‌کند."
                    MinWidth="120" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                    FontSize="{DynamicResource ButtonFontSize}"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="📊 ساخت فایل اکسل" Command="{Binding ExportCommand}" ToolTip="ساخت فایل اکسل از پرونده‌ها."
                    MinWidth="160" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource OnSuccessBrush}" FontWeight="Bold" Margin="0,0,10,0"
                    FontSize="{DynamicResource ButtonFontSize}"/>
            <Button Content="📁 باز کردن پوشه" Command="{Binding OpenFolderCommand}" ToolTip="باز کردن پوشه‌ای که فایل‌های اکسل در آن ساخته می‌شن."
                    MinWidth="130" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,10,0"
                    FontSize="{DynamicResource ButtonFontSize}"/>
            <Button Content="🔄 بروزرسانی" Command="{Binding RefreshCommand}" ToolTip="لیست فایل‌های اکسل ساخته‌شده رو دوباره می‌خونه."
                    MinWidth="100" Background="{DynamicResource TextSecondaryBrush}" Foreground="{DynamicResource OnSecondaryBrush}"
                    FontSize="{DynamicResource ButtonFontSize}"/>
        </StackPanel>

        <ProgressBar Grid.Row="3" IsIndeterminate="{Binding IsExporting}" Height="6" Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10"/>

        <ListBox Grid.Row="4" ItemsSource="{Binding ExistingFiles}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 FontSize="{DynamicResource FontSize}" Padding="8"/>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" FontSize="{DynamicResource LabelFontSize}" Margin="0,5,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>