<UserControl x:Class="NezamMonitorPro.App.Views.ExcelExportView" FlowDirection="{DynamicResource MainWindowFlowDirection}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📤 خروجی اکسل" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="📊 ساخت فایل اکسل" Command="{Binding ExportCommand}"
                    MinWidth="160" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource OnSuccessBrush}" FontWeight="Bold" Margin="0,0,10,0"
                    FontSize="{DynamicResource ButtonFontSize}"/>
            <Button Content="📁 باز کردن پوشه" Command="{Binding OpenFolderCommand}"
                    MinWidth="130" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" Margin="0,0,10,0"
                    FontSize="{DynamicResource ButtonFontSize}"/>
            <Button Content="🔄 بروزرسانی" Command="{Binding RefreshCommand}"
                    MinWidth="100" Background="{DynamicResource TextSecondaryBrush}" Foreground="{DynamicResource OnSecondaryBrush}"
                    FontSize="{DynamicResource ButtonFontSize}"/>
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding ExistingFiles}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                 FontSize="{DynamicResource FontSize}" Padding="8"/>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource LabelFontSize}" Margin="0,5,0,0"/>
    </Grid>
</UserControl>