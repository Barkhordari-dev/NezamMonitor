<Window x:Class="NezamMonitorPro.App.Views.SetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعریف رمز عبور اولیه"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="Transparent"
        FontFamily="{DynamicResource FontFamily}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

    <Window.Resources>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="16,0,54,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="16,0,54,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevealToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="نمایش یا پنهان کردن رمزی که نوشته‌ای."/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ProButton}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ProButtonGhost}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#B3050B18"/>

        <Border Margin="28"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Effect="{DynamicResource CardShadowEffect}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="24"/>
            </Border.RenderTransform>
            <Border CornerRadius="24" ClipToBounds="True" x:Name="MainCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- هدر -->
                    <Border Grid.Row="0" Padding="26,20" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="15"
                                    Background="#33FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="&#xE785;" FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="24" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="تعریف رمز عبور اولیه" FontSize="20" FontWeight="Bold" ToolTip="این رمز پایگاه داده محلی رو رمزنگاری می‌کنه؛ اگه فراموشش کنی، داده‌ها باز نمی‌شن."
                                           Foreground="White"/>
                                <TextBlock Text="این رمز پایگاه داده محلی رو رمزنگاری می‌کنه؛ فراموشش نکن."
                                           FontSize="12" Foreground="#DCE7FF"
                                           Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>

                            <Button Grid.Column="2" x:Name="CloseButton" Width="34" Height="34"
                                    Padding="0" Background="#22FFFFFF" BorderThickness="0"
                                    Cursor="Hand" ToolTip="بستن" Click="CloseButton_Click"
                                    VerticalAlignment="Top" Style="{StaticResource ProIconButton}">
                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="{DynamicResource FontSize}" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- بدنه -->
                    <StackPanel Grid.Row="1" Margin="28,22,28,24">

                        <TextBlock Text="رمز عبور" FontSize="{DynamicResource LabelFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="2,0,0,8"/>
                        <Grid>
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"
                                         KeyDown="PasswordBox_KeyDown"/>
                            <TextBox x:Name="PasswordTextBox" Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" KeyDown="PasswordBox_KeyDown"/>
                            <ToggleButton x:Name="RevealToggle" Style="{StaticResource RevealToggle}"
                                          HorizontalAlignment="Left" Margin="8,0,0,0"
                                          Click="RevealToggle_Click">
                                <TextBlock x:Name="RevealIcon" Text="&#xE7B3;"
                                           FontFamily="{DynamicResource IconFontFamily}" FontSize="17"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <!-- S-027: هشدار Caps Lock، مثل پنجره رمز برنامه. -->
                        <TextBlock x:Name="CapsWarning" Visibility="Collapsed"
                                   Text="⚠  Caps Lock روشن است" ToolTip="کلید Caps Lock روشن هست؛ رمز رو با حروف بزرگ می‌نویسی."
                                   FontSize="11.5" Foreground="{DynamicResource WarningTextBrush}"
                                   Margin="2,8,0,0"/>

                        <!-- نشانگر قدرت رمز -->
                        <Grid Margin="2,10,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="StrengthBar1" Width="46" Height="5" CornerRadius="3"
                                        Background="{DynamicResource BorderBrush}" Margin="0,0,5,0"/>
                                <Border x:Name="StrengthBar2" Width="46" Height="5" CornerRadius="3"
                                        Background="{DynamicResource BorderBrush}" Margin="0,0,5,0"/>
                                <Border x:Name="StrengthBar3" Width="46" Height="5" CornerRadius="3"
                                        Background="{DynamicResource BorderBrush}" Margin="0,0,5,0"/>
                                <Border x:Name="StrengthBar4" Width="46" Height="5" CornerRadius="3"
                                        Background="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="StrengthText" Grid.Column="1" FontSize="11"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Text=""/>
                        </Grid>

                        <TextBlock Text="تکرار رمز عبور" FontSize="{DynamicResource LabelFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="2,18,0,8"/>
                        <Grid>
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                         KeyDown="ConfirmPasswordBox_KeyDown"/>
                            <TextBox x:Name="ConfirmTextBox" Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" KeyDown="ConfirmPasswordBox_KeyDown"/>
                            <ToggleButton x:Name="ConfirmRevealToggle" Style="{StaticResource RevealToggle}"
                                          HorizontalAlignment="Left" Margin="8,0,0,0"
                                          Click="ConfirmRevealToggle_Click">
                                <TextBlock x:Name="ConfirmRevealIcon" Text="&#xE7B3;"
                                           FontFamily="{DynamicResource IconFontFamily}" FontSize="17"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Text="" FontSize="12.5"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   Margin="2,10,0,0" TextWrapping="Wrap" LineHeight="18"/>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="برای امنیت بیشتر، بهتر است رمزت هم حرف داشته باشد هم عدد؛ ولی اجباری نیست."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" MaxWidth="320"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- A11Y-003: قالب ProButtonGhost زیرخط AccessKey را نمی‌شناسد؛
                                     AccessText صریح می‌گذاریم تا «_انصراف» درست کار کند. -->
                                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                                        Click="CancelButton_Click" Margin="0,0,10,0">
                                    <AccessText Text="_انصراف"/>
                                </Button>
                                <Button x:Name="SaveButton" Content="_ذخیره و ورود  ←"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="SaveButton_Click" IsDefault="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
