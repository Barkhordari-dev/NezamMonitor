<Window x:Class="NezamMonitorPro.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تغییر رمز عبور"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="Transparent"
        FontFamily="{DynamicResource FontFamily}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0,54,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="16,0,54,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevealToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="نمایش / مخفی کردن رمز"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ProButton}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ProButtonGhost}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#B3050B18"/>

        <Border Margin="24"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Effect="{DynamicResource CardShadowEffect}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate" Y="24"/>
            </Border.RenderTransform>
            <Border CornerRadius="24" ClipToBounds="True" x:Name="MainCard">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="24,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0"/>
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14"
                                    Background="#33FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="22" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="تغییر رمز عبور برنامه" FontSize="18" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="رمز عبور فعلی و رمز عبور جدید خود را وارد کنید."
                                           FontSize="12" Foreground="#DCE7FF"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="2" x:Name="CloseButton" Width="32" Height="32"
                                    Padding="0" Background="#22FFFFFF" BorderThickness="0"
                                    Cursor="Hand" ToolTip="بستن" Click="CloseButton_Click"
                                    VerticalAlignment="Top" Style="{StaticResource ProIconButton}">
                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="13" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <StackPanel Grid.Row="1" Margin="24,20,24,22">

                        <!-- Current Password -->
                        <TextBlock Text="رمز عبور فعلی" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="2,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                         KeyDown="Password_KeyDown"/>
                            <TextBox x:Name="CurrentPasswordTextBox" Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" KeyDown="Password_KeyDown"/>
                            <ToggleButton x:Name="CurrentRevealToggle" Style="{StaticResource RevealToggle}"
                                          HorizontalAlignment="Left" Margin="6,0,0,0"
                                          Click="CurrentRevealToggle_Click">
                                <TextBlock x:Name="CurrentRevealIcon" Text="&#xE7B3;"
                                           FontFamily="{DynamicResource IconFontFamily}" FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <!-- New Password -->
                        <TextBlock Text="رمز عبور جدید" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="2,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                         KeyDown="Password_KeyDown"/>
                            <TextBox x:Name="NewPasswordTextBox" Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" KeyDown="Password_KeyDown"/>
                            <ToggleButton x:Name="NewRevealToggle" Style="{StaticResource RevealToggle}"
                                          HorizontalAlignment="Left" Margin="6,0,0,0"
                                          Click="NewRevealToggle_Click">
                                <TextBlock x:Name="NewRevealIcon" Text="&#xE7B3;"
                                           FontFamily="{DynamicResource IconFontFamily}" FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <!-- Confirm New Password -->
                        <TextBlock Text="تکرار رمز عبور جدید" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="2,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource ModernPasswordBox}"
                                         KeyDown="Password_KeyDown"/>
                            <TextBox x:Name="ConfirmPasswordTextBox" Style="{StaticResource ModernTextBox}"
                                     Visibility="Collapsed" KeyDown="Password_KeyDown"/>
                            <ToggleButton x:Name="ConfirmRevealToggle" Style="{StaticResource RevealToggle}"
                                          HorizontalAlignment="Left" Margin="6,0,0,0"
                                          Click="ConfirmRevealToggle_Click">
                                <TextBlock x:Name="ConfirmRevealIcon" Text="&#xE7B3;"
                                           FontFamily="{DynamicResource IconFontFamily}" FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Text="" FontSize="12"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Margin="2,8,0,0" TextWrapping="Wrap"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Text="حداقل ۸ کاراکتر."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CancelButton" Content="انصراف"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="CancelButton_Click" Margin="0,0,10,0"/>
                                <Button x:Name="SaveButton" Content="تغییر رمز عبور"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="SaveButton_Click" IsDefault="True"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
