<Window x:Class="NezamMonitorPro.App.Views.DirectoryOfficeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NezamMonitorPro.App.Converters"
        Title="مشخصات دفتر"
        Width="680" Height="620" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:PlaceholderTextOpacityConverter x:Key="PlaceholderOpacity"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- سربرگ -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   ToolTip="دفتری که از پرونده انتخاب شده است."/>

        <!-- در حال بارگذاری -->
        <TextBlock Grid.Row="1" Text="در حال دریافت اطلاعات دفتر…" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- یافت نشد / دلیل سید -->
        <TextBlock Grid.Row="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>

        <!-- جزییات -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- کارت اطلاعات دفتر -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="اطلاعات دفتر" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="نام دفتر:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding Name, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="شماره مجوز:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Licence}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding Licence, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="مسئول دفتر:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Manager}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding Manager, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="همراه مسئول:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ManagerMobile}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding ManagerMobile, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="رابط دفتر:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Contact}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding Contact, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="آدرس:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Address}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding Address, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="تلفن:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Phone}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding Phone, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Text="شهرستان:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding City}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding City, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Text="استان صادرکننده:" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Province}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Opacity="{Binding Province, Converter={StaticResource PlaceholderOpacity}}"/>
                            <TextBlock Grid.Row="9" Grid.Column="0" Text="آخرین بروزرسانی:" FontWeight="Bold" FontSize="14"
                                       Visibility="{Binding HasUpdatedAt, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding UpdatedAt}" FontSize="14" TextWrapping="Wrap"
                                       Visibility="{Binding HasUpdatedAt, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- کارت اعضا -->
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{Binding MemberCountText}" FontWeight="Bold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock Text="برای دیدن پروفایل هر مهندس، روی نامش بزنید." FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="این دفتر عضوی ندارد" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding HasMembers, Converter={StaticResource InverseBoolConverter}}"/>
                        <ItemsControl ItemsSource="{Binding Members}"
                                      Visibility="{Binding HasMembers, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FullName}" FontSize="14" TextWrapping="Wrap"
                                                           Cursor="Hand" Tag="{Binding FullName}"
                                                           MouseLeftButtonUp="Member_Click"
                                                           ToolTip="پروفایل مهندس باز می‌شود.">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="رشته: "/><Run Text="{Binding Discipline}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- دکمه بستن -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="بستن" Click="CloseButton_Click" Padding="14,6" FontSize="14"
                    ToolTip="پنجره را می‌بندد."/>
        </StackPanel>
    </Grid>
</Window>
