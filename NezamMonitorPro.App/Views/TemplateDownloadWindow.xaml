<Window x:Class="NezamMonitorPro.App.Views.TemplateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دانلود تمپلیت از گوگل درایو"
        Width="700" Height="520"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="FolderNameText" Text="پوشه تمپلیت‌ها" FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center" ToolTip="پوشه‌ای که الان داری می‌بینی؛ داخل پوشه‌ها می‌تونی بری و برگردی."/>
            <Button x:Name="BackButton" Content="⬅️ _بازگشت به پوشه اصلی" Click="BackButton_Click"
                    Visibility="Collapsed" Margin="12,0,0,0" TabIndex="1"
                    ToolTip="برمی‌گردی به پوشه تمپلیت‌های اصلی."/>
            <Button Content="🌐 باز کردن در _مرورگر" Click="OpenBrowserButton_Click" Margin="12,0,0,0" TabIndex="2"
                    ToolTip="همین پوشه در مرورگر باز می‌شه؛ اگه خواستی دستی هم می‌تونی تمپلیت بگیری."/>
        </StackPanel>

        <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" x:Name="EntriesGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single" TabIndex="3"
                  MouseDoubleClick="EntriesGrid_MouseDoubleClick"
                  SelectionChanged="EntriesGrid_SelectionChanged"
                  ToolTip="روی پوشه دابل‌کلیک کنی واردش می‌شوی؛ روی فایل دابل‌کلیک کنی تیکش می‌خورد.">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsFile}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"
                                    ElementStyle="{StaticResource GridCellPath}"/>
                <DataGridTextColumn Header="نوع" Binding="{Binding TypeDisplay}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <ProgressBar x:Name="LoadingBar" Width="120" Height="14" IsIndeterminate="True"
                         Visibility="Collapsed" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource LabelFontSize}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button x:Name="DownloadButton" Content="⬇ _دانلود انتخاب‌شده‌ها" Click="DownloadButton_Click" TabIndex="4"
                    ToolTip="فایل‌های تیک‌خورده دانلود و در پوشه تمپلیت‌های برنامه قرار می‌گیرند؛ اگه فایلی از قبل باشد، اول ازت می‌پرسد."/>
            <Button x:Name="OpenFolderButton" Content="📁 _باز کردن" Click="OpenFolderButton_Click" Margin="8,0,0,0" TabIndex="5"
                    IsEnabled="False"
                    ToolTip="پوشه انتخاب‌شده را باز می‌کند؛ روی فایل کاری نمی‌کند."/>
            <Button Content="_بستن" Click="CloseButton_Click" Margin="8,0,0,0" TabIndex="6"
                    ToolTip="این پنجره بسته می‌شود؛ دانلودهای انجام‌شده سر جایشان می‌مانند."/>
        </StackPanel>
    </Grid>
</Window>
