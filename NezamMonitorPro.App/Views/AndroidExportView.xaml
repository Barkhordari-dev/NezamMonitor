<UserControl x:Class="NezamMonitorPro.App.Views.AndroidExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="📱 خروجی برای اندروید" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,15" ToolTip="ساخت فایل داده (`.nzmdata`) برای وارد کردن در برنامه اندروید."/>

            <!-- Info Card -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="این ابزار فایل داده‌ی `.nzmdata` برای وارد کردن در برنامه اندروید ایجاد می‌کند." 
                               FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource LabelFontSize}" Foreground="#5D6D7E">
                        فایل خروجی شامل تمام پرونده‌ها، مهندسین، حق‌الزحمه، گزارش‌ها و ویرایش‌های پیگیری است.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Output Path Section -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="مسیر ذخیره:" VerticalAlignment="Center" FontWeight="Bold" ToolTip="پوشه‌ای که فایل خروجی اندروید در آن ساخته می‌شه." 
                               FontSize="{DynamicResource FontSize}" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputPath, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource PathTextBoxStyle}"
                             MinWidth="200" VerticalContentAlignment="Center" FontSize="{DynamicResource InputFontSize}" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="📁 انتخاب مسیر" Command="{Binding BrowseCommand}" 
                            MinWidth="120" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" 
                            FontSize="{DynamicResource ButtonFontSize}" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="📋 کپی مسیر" Command="{Binding CopyPathCommand}" ToolTip="مسیر ذخیره را در حافظه کپی می‌کند تا جای دیگر بچسبانی."
                            MinWidth="100" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                            FontSize="{DynamicResource ButtonFontSize}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Password (optional, SEC-015) -->
            <Border Grid.Row="3" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔐 رمز خروجی (اختیاری):" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                               ToolTip="اگه رمز بذاری، فایل خروجی رمزنگاری می‌شه."/>
                    <Grid>
                        <PasswordBox x:Name="ExportPasswordBox" Height="38" VerticalContentAlignment="Center"
                                     FlowDirection="LeftToRight" Padding="12,0,38,0"
                                     ToolTip="رمز فایل خروجی؛ با چشم کنارش می‌تونی ببینیش."
                                     PasswordChanged="ExportPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="ExportVisiblePasswordBox" Height="38" VerticalContentAlignment="Center"
                                 FlowDirection="LeftToRight" Padding="12,0,38,0" Visibility="Collapsed"
                                 ToolTip="رمز فایل خروجی؛ با چشم کنارش می‌تونی ببینیش."
                                 TextChanged="ExportVisiblePasswordBox_TextChanged"/>
                        <ToggleButton x:Name="ShowExportPasswordToggle" Width="30" Height="30" HorizontalAlignment="Right"
                                      Style="{StaticResource EyeButtonStyle}" Click="ToggleExportPassword_Click"
                                      ToolTip="نمایش یا پنهان کردن رمزی که نوشته‌ای."/>
                    </Grid>
                    <TextBlock Text="اگر رمز بگذاری، فایل خروجی رمزنگاری می‌شود." FontSize="{DynamicResource LabelFontSize}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="UnencryptedWarning" Text="⚠ خروجی رمزنگاری نشده است؛ فایل شامل همه اطلاعات پرونده‌هاست."
                               FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource WarningTextBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <!-- Progress indicator -->
                    <ProgressBar IsIndeterminate="{Binding IsExporting}" Height="6" Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,10"/>
                    
                    <!-- Export info -->
                    <TextBlock Text="{Binding LastExportInfo}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" 
                               FontSize="{DynamicResource LabelFontSize}" LineHeight="22"/>

                    <!-- Open the folder that holds the exported file -->
                    <Button Content="📂 باز کردن پوشه خروجی" Command="{Binding OpenOutputFolderCommand}" ToolTip="پوشه‌ای که فایل خروجی در آن ساخته شد را باز می‌کند."
                            Visibility="{Binding LastExportPath, Converter={StaticResource StringToVisConverter}}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" MinWidth="190" MinHeight="36"
                            Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                            FontSize="{DynamicResource ButtonFontSize}"/>
                </StackPanel>
            </Border>

            <!-- Export Button -->
            <Button Grid.Row="5" Content="📦 ایجاد خروجی اندروید" Command="{Binding ExportCommand}" ToolTip="ساخت فایل `.nzmdata` با پرونده‌ها، ناظرین، حق‌الزحمه و گزارش‌ها." 
                    MinHeight="45" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource OnSuccessBrush}" FontSize="{DynamicResource FontSize}" 
                    FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" MinWidth="250"/>
        </Grid>
    </ScrollViewer>
</UserControl>
