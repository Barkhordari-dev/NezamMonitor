<UserControl x:Class="NezamMonitorPro.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>

        <!-- ═══ کارت آمار ═══ -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.08" Color="#0B1B33"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ═══ ردیف متریک ═══ -->
        <Style x:Key="MetricRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ═══ دکمه سریع ═══ -->
        <Style x:Key="QuickTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

    </UserControl.Resources>

    <!-- جهت چیدمان این صفحه عمداً آینهٔ RTL برنامه است (به درخواست کاربر):
         پنل گرادیانی سمت راست، متن‌ها و کارت‌ها از چپ. متن فارسی داخل هر بلوک دست‌نخورده می‌ماند. -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          MinWidth="0" MinHeight="0"
          FlowDirection="LeftToRight">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      MinWidth="0">
            <StackPanel Margin="22,18,22,24" HorizontalAlignment="Stretch" MinWidth="0">

            <!-- ════════════ HERO ════════════ -->
            <Border CornerRadius="20" Padding="0" HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Effect="{DynamicResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- متن خوش‌آمد (وسط‌چین) -->
                    <StackPanel Grid.Column="0" Margin="28,24" VerticalAlignment="Center"
                                HorizontalAlignment="Stretch" FlowDirection="LeftToRight">
                        <Border Background="#142563EB" CornerRadius="14" Padding="10,4"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="سلام، خوش آمدید 👋" FontSize="13.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Stretch" TextAlignment="Center"/>
                        <TextBlock Text="مرکز کنترل پرونده‌های نظام مهندسی" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"
                                   HorizontalAlignment="Stretch" TextAlignment="Center"/>
                        <TextBlock Text="وضعیت لحظه‌ای پرونده‌ها، ناظرین، حق‌الزحمه و گزارش‌ها در یک نگاه"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="560"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Content="به‌روزرسانی از سامانه" Click="GoToUpdate_Click"
                                    Style="{StaticResource ProButton}" Height="38" Margin="0,0,10,0"/>
                            <Button Content="تولید گزارش" Click="GoToGenerator_Click"
                                    Style="{StaticResource ProButtonGhost}" Height="38"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- پنل گرادیانی تزئینی (سمت راست) -->
                    <Border Grid.Column="1" Width="260" CornerRadius="0,20,20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" x:Name="GradStart"/>
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1" x:Name="GradEnd"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="180" Height="180" Fill="#14FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-60,0,0"/>
                            <Ellipse Width="120" Height="120" Fill="#10FFFFFF"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-30,-40"/>

                            <StackPanel VerticalAlignment="Center" Margin="20">
                                <Border Width="54" Height="54" CornerRadius="16" Background="#26FFFFFF"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE1D3;" FontFamily="{DynamicResource IconFontFamily}"
                                               FontSize="26" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="نسخه ۳ پرو" FontSize="16" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="پایگاه دادهٔ رمزنگاری‌شده" FontSize="10.5"
                                           Foreground="#DCE7FF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Background="#26FFFFFF" CornerRadius="8" Padding="10,5" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="آخرین به‌روزرسانی" FontSize="9.5" Foreground="#DCE7FF"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastUpdate}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ════════════ کارت‌های آماری ════════════ -->
            <UniformGrid Columns="4" Margin="0,14,0,0" HorizontalAlignment="Stretch">

                <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="کل پرونده‌ها" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalCases}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="2" Background="{DynamicResource PrimaryBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#142563EB"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="4,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ناظرین" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalEngineers}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="2" Background="{DynamicResource SuccessBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#1410B981"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="20" Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="8,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="حق‌الزحمه‌ها" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalFees}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="2" Background="{DynamicResource WarningBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#14F59E0B"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE8C7;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="20" Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="گزارش‌ها" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalReports}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#147C3AED"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ════════════ بدنه دو ستونی ════════════ -->
            <Grid Margin="0,14,0,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- کیفیت داده -->
                <Border Grid.Column="0" Style="{StaticResource ProCard}" Padding="18,16" Margin="0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="کامل بودن اطلاعات پرونده‌ها"
                                       Style="{StaticResource ProSectionTitle}" Margin="0" FontSize="16"
                                       TextAlignment="Center" HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="10"
                                    Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای مشخصات" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithSpecs}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithSpecs}" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای ناظر" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithEngineers}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithEngineers}" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای حق‌الزحمه" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithFees}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithFees}" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource WarningBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای گزارش" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithReports}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithReports}" FontWeight="Bold"
                                           FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>

                        <Grid>
                            <TextBlock Text="آخرین به‌روزرسانی" Style="{StaticResource StatLabel}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding LastUpdate}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- دسترسی سریع -->
                <Border Grid.Column="2" Style="{StaticResource ProCard}" Padding="18,16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="دسترسی سریع" Style="{StaticResource ProSectionTitle}" FontSize="16"
                                   TextAlignment="Center" HorizontalAlignment="Stretch"/>

                        <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                            <Button Style="{StaticResource QuickTile}" Margin="0,0,6,8" Click="GoToUpdate_Click">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#1410B981"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="16" Foreground="{DynamicResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="به‌روزرسانی" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="6,0,0,8" Click="GoToGenerator_Click">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#142563EB"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70C;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="16" Foreground="{DynamicResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="تولید گزارش" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="0,0,6,0" Click="GoToCases_Click">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#147C3AED"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="پرونده‌ها" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="6,0,0,0" Click="GoToFollowUp_Click">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#14F59E0B"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="16" Foreground="{DynamicResource WarningBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="پیگیری" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12"/>

                        <TextBlock Text="میانبرهای صفحه‌کلید" Style="{StaticResource StatLabel}"
                                   Margin="0,0,0,8" FontWeight="SemiBold"/>

                        <Grid Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource Kbd}">
                                    <TextBlock Text="Ctrl + D" FontSize="10.5" FontFamily="Segoe UI"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Border>
                                <TextBlock Text="داشبورد" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource Kbd}">
                                    <TextBlock Text="Ctrl + O" FontSize="10.5" FontFamily="Segoe UI"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Border>
                                <TextBlock Text="به‌روزرسانی" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource Kbd}">
                                    <TextBlock Text="Ctrl + G" FontSize="10.5" FontFamily="Segoe UI"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </Border>
                                <TextBlock Text="تولید گزارش" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
