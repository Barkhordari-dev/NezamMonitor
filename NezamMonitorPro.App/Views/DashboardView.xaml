<UserControl x:Class="NezamMonitorPro.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- ═══ Stat tile ═══ -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.10" Color="#0B1B33"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ═══ Progress row item ═══ -->
        <Style x:Key="MetricRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style x:Key="QuickTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer Padding="26" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- ════════════ HERO ════════════ -->
            <Border Style="{StaticResource ProCard}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="22,20,10,20" VerticalAlignment="Center">
                        <TextBlock Text="سلام، خوش آمدید 👋" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="مرکز کنترل سیستم مانیتورینگ" Style="{StaticResource ProPageTitle}" Margin="0,6,0,0"/>
                        <TextBlock Text="وضعیت لحظه‌ای پرونده‌ها، گزارش‌ها و پیگیری‌ها در یک نگاه"
                                   Style="{StaticResource ProBody}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="520" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <!-- Decorative gradient panel -->
                    <Border Grid.Column="1" Width="230" CornerRadius="16,0,0,16" Margin="0,0,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <!-- NOTE: GradientStop.Color needs a Color, not a Brush.
                                     The colours are resolved by the code-behind at runtime. -->
                                <GradientStop Color="#2563EB" Offset="0" x:Name="GradStart"/>
                                <GradientStop Color="#7C3AED" Offset="1" x:Name="GradEnd"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="&#xE1D3;" FontFamily="{DynamicResource IconFontFamily}" FontSize="40"
                                           Foreground="#66FFFFFF" HorizontalAlignment="Right"/>
                                <TextBlock Text="نسخه ۳ پرو" FontSize="16" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Right" Margin="0,10,0,0"/>
                                <TextBlock Text="Version 3 Pro" FontFamily="Segoe UI" FontSize="11"
                                           Foreground="#CCFFFFFF" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ════════════ STAT TILES ════════════ -->
            <UniformGrid Columns="4" Margin="0,0,0,4">
                <Border Style="{StaticResource StatTile}" Margin="0,0,7,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="کل پرونده‌ها" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalCases}" Style="{StaticResource StatNumber}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#1A2563EB">
                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="20"
                                       Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="7,0,7,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ناظرین" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalEngineers}" Style="{StaticResource StatNumber}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#1A10B981">
                            <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFontFamily}" FontSize="20"
                                       Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="7,0,7,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="حق‌الزحمه‌ها" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalFees}" Style="{StaticResource StatNumber}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#1AF59E0B">
                            <TextBlock Text="&#xE825;" FontFamily="{DynamicResource IconFontFamily}" FontSize="20"
                                       Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="7,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="گزارش‌ها" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalReports}" Style="{StaticResource StatNumber}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="#1A7C3AED">
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFontFamily}" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ════════════ TWO-COLUMN BODY ════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: data completeness -->
                <Border Grid.Column="0" Style="{StaticResource ProCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="کامل بودن اطلاعات پرونده‌ها" Style="{StaticResource ProSectionTitle}" Margin="0"/>
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="10,4"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>

                        <!-- Specs -->
                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای مشخصات" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="120"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithSpecs}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithSpecs}" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" MinWidth="42"
                                           TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Engineers -->
                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای ناظر" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="120"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithEngineers}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithEngineers}" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" MinWidth="42"
                                           TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Fees -->
                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای حق‌الزحمه" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="120"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithFees}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithFees}" FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" MinWidth="42"
                                           TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Reports -->
                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای گزارش" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextBrush}" MinWidth="120"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithReports}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithReports}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" MinWidth="42"
                                           TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12"/>

                        <Grid>
                            <TextBlock Text="آخرین به‌روزرسانی" Style="{StaticResource StatLabel}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LastUpdate}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RIGHT: quick actions -->
                <Border Grid.Column="2" Style="{StaticResource ProCard}">
                    <StackPanel>
                        <TextBlock Text="دسترسی سریع" Style="{StaticResource ProSectionTitle}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Button Style="{StaticResource QuickTile}" Margin="0,0,6,10" Click="GoToUpdate_Click">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="11" Background="#1A10B981"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}" FontSize="17"
                                                   Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="به‌روزرسانی" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="6,0,0,10" Click="GoToGenerator_Click">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="11" Background="#1A2563EB"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70C;" FontFamily="{DynamicResource IconFontFamily}" FontSize="17"
                                                   Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="تولید گزارش" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="0,0,6,0" Click="GoToCases_Click">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="11" Background="#1A7C3AED"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}" FontSize="17"
                                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="پرونده‌ها" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="6,0,0,0" Click="GoToFollowUp_Click">
                                <StackPanel>
                                    <Border Width="38" Height="38" CornerRadius="11" Background="#1AF59E0B"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="17"
                                                   Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="پیگیری" HorizontalAlignment="Center" Margin="0,7,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,12"/>

                        <TextBlock Text="میانبرهای صفحه‌کلید" Style="{StaticResource StatLabel}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Ctrl + D" HorizontalAlignment="Left" FontSize="11.5"
                                       FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="داشبورد" HorizontalAlignment="Right" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Ctrl + O" HorizontalAlignment="Left" FontSize="11.5"
                                       FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="به‌روزرسانی" HorizontalAlignment="Right" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Ctrl + G" HorizontalAlignment="Left" FontSize="11.5"
                                       FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="تولید گزارش" HorizontalAlignment="Right" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
