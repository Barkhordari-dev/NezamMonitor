<UserControl x:Class="NezamMonitorPro.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>

        <!-- ═══ کارت آمار ═══ -->
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXLarge}"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.08" Color="{DynamicResource ShadowColor}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource DisplayFontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- ═══ ردیف متریک ═══ -->
        <Style x:Key="MetricRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- ═══ دکمه سریع ═══ -->
        <Style x:Key="QuickTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource LabelFontSize}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- T-016: گوشه و سایه از توکن‌های حالت دکمه خوانده می‌شوند. -->
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ButtonCornerRadius}"
                                Effect="{DynamicResource ButtonShadowEffect}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

    </UserControl.Resources>

    <!-- جهت چیدمان این صفحه عمدا آینه RTL برنامه است (به درخواست کاربر):
         پنل گرادیانی سمت راست، متن‌ها و کارت‌ها از چپ. متن فارسی داخل هر بلوک دست‌نخورده می‌ماند. -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          MinWidth="0" MinHeight="0"
          FlowDirection="LeftToRight">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      MinWidth="0">
            <StackPanel Margin="22,18,22,24" HorizontalAlignment="Stretch" MinWidth="0">

            <!-- ════════════ HERO ════════════ -->
            <Border CornerRadius="{DynamicResource RadiusXLarge}" Padding="0" HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Effect="{DynamicResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- متن خوش‌آمد (وسط‌چین) -->
                    <StackPanel Grid.Column="0" Margin="28,24" VerticalAlignment="Center"
                                HorizontalAlignment="Stretch" FlowDirection="LeftToRight">
                        <Border Background="{DynamicResource HoverOverlayBrush}" CornerRadius="{DynamicResource RadiusBadge}" Padding="10,4"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PrimaryBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding WelcomeMessage}" FontSize="{DynamicResource FontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Stretch" TextAlignment="Center"/>
                        <TextBlock Text="NezamMonitor Pro — مانیتورینگ نظام مهندسی" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   HorizontalAlignment="Stretch" TextAlignment="Center"/>
                        <TextBlock Text="وضعیت لحظه‌ای پرونده‌ها، ناظرین، حق‌الزحمه و گزارش‌ها در یک نگاه"
                                   FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="560"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Content="_به‌روزرسانی از سامانه" Click="GoToUpdate_Click" ToolTip="رفتن مستقیم به صفحه به‌روزرسانی."
                                    Style="{StaticResource ProButton}" Margin="0,0,10,0" TabIndex="1"/>
                            <Button Content="_تولید گزارش" Click="GoToGenerator_Click" ToolTip="رفتن مستقیم به تب تولید گزارش."
                                    Style="{StaticResource ProButtonGhost}" TabIndex="2"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- پنل گرادیانی تزیینی (سمت راست) -->
                    <Border x:Name="HeroPanel" Grid.Column="1" Width="260" CornerRadius="0,20,20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource PrimaryColor}" Offset="0" x:Name="GradStart"/>
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="1" x:Name="GradEnd"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="180" Height="180" Fill="#14FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-60,0,0"/>
                            <Ellipse Width="120" Height="120" Fill="#10FFFFFF"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-30,-40"/>

                            <!-- A11Y-007c: لایه تیره نیمه‌شفاف پشت متن‌های روی گرادیان -->
                            <Border Background="#1A000000" CornerRadius="{DynamicResource RadiusLarge}" Margin="12"/>
                            <StackPanel VerticalAlignment="Center" Margin="20">
                                <Border Width="54" Height="54" CornerRadius="{DynamicResource RadiusBadge}" Background="#26FFFFFF"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE1D3;" FontFamily="{DynamicResource IconFontFamily}"
                                               FontSize="{DynamicResource HeadingFontSize}" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding AppVersion, StringFormat='{}نسخه {0} پرو'}" FontSize="{DynamicResource SubHeadingFontSize}" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="پایگاه داده رمزنگاری‌شده" FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Background="#26FFFFFF" CornerRadius="{DynamicResource RadiusMedium}" Padding="10,5" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="آخرین به‌روزرسانی" FontSize="{DynamicResource CaptionFontSize}" Foreground="White" ToolTip="تاریخ و ساعت آخرین باری که از سامانه داده گرفتی."
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastUpdate}" FontSize="{DynamicResource CaptionFontSize}" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ════════════ کارت‌های آماری ════════════ -->
            <UniformGrid x:Name="StatGrid" Columns="4" Margin="0,14,0,0" HorizontalAlignment="Stretch">

                <Border Style="{StaticResource StatTile}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="کل پرونده‌ها" Style="{StaticResource StatLabel}" ToolTip="تعداد همه‌ی پرونده‌هایی که در پایگاه داده هست."/>
                            <TextBlock Text="{Binding TotalCases}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource PrimaryBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="4,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ناظرین" Style="{StaticResource StatLabel}" ToolTip="تعداد ناظرینی که در پرونده‌ها ثبت شدن."/>
                            <TextBlock Text="{Binding TotalEngineers}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource SuccessBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource SuccessTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="8,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="حق‌الزحمه‌ها" Style="{StaticResource StatLabel}" ToolTip="تعداد ردیف‌های حق‌الزحمه ثبت‌شده."/>
                            <TextBlock Text="{Binding TotalFees}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource WarningBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE8C7;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource WarningTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource StatTile}" Margin="12,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="گزارش‌ها" Style="{StaticResource StatLabel}" ToolTip="تعداد گزارش‌هایی که در سامانه ثبت شده یا روی سیستم ساخته شده."/>
                            <TextBlock Text="{Binding TotalReports}" Style="{StaticResource StatNumber}"/>
                            <Border Height="3" Width="34" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.85"/>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="&#xE7C3;" FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ════════════ بدنه دو ستونی ════════════ -->
            <Grid x:Name="BodyGrid" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition x:Name="RightColumn" Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- کیفیت داده -->
                <Border x:Name="DataCard" Grid.Column="0" Style="{StaticResource ProCard}" Padding="18,16" Margin="0">
                    <StackPanel>
                        <!-- L-012: وضعیت اتصال فقط در هیرو نشان داده می‌شود (تکرار حذف شد). -->
                        <TextBlock Text="کامل بودن اطلاعات پرونده‌ها" ToolTip="چند پرونده مشخصات، ناظر، حق‌الزحمه و گزارش دارن؛ پرونده ناقص از اینجا معلوم می‌شه."
                                   Style="{StaticResource ProSectionTitle}" Margin="0,0,0,12" FontSize="{DynamicResource SubHeadingFontSize}"
                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"/>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای مشخصات" VerticalAlignment="Center" ToolTip="تعداد پرونده‌هایی که مشخصاتشان از سامانه گرفته شده."
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithSpecs}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithSpecs}" FontWeight="Bold"
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource SuccessTextBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای ناظر" VerticalAlignment="Center" ToolTip="تعداد پرونده‌هایی که حداقل یک ناظر دارن."
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithEngineers}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithEngineers}" FontWeight="Bold"
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای حق‌الزحمه" VerticalAlignment="Center" ToolTip="تعداد پرونده‌هایی که حداقل یک حق‌الزحمه دارن."
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithFees}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithFees}" FontWeight="Bold"
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource WarningTextBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource MetricRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="دارای گزارش" VerticalAlignment="Center" ToolTip="تعداد پرونده‌هایی که حداقل یک گزارش دارن."
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextBrush}" MinWidth="118"
                                           HorizontalAlignment="Stretch" TextAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Height="7" Margin="14,0"
                                             Value="{Binding CasesWithReports}" Maximum="{Binding TotalCases}"
                                             Style="{StaticResource ProProgressBar}" VerticalAlignment="Center"
                                             HorizontalAlignment="Stretch"/>
                                <TextBlock Grid.Column="2" Text="{Binding CasesWithReports}" FontWeight="Bold"
                                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                            </Grid>
                        </Border>
                        <!-- L-012: «آخرین به‌روزرسانی» فقط در پنل هیرو هست (تکرار پایین کارت حذف شد). -->
                    </StackPanel>
                </Border>

                <!-- دسترسی سریع -->
                <Border x:Name="QuickCard" Grid.Column="2" Style="{StaticResource ProCard}" Padding="18,16" Margin="0">
                    <StackPanel>
                        <TextBlock Text="دسترسی سریع" Style="{StaticResource ProSectionTitle}" FontSize="{DynamicResource SubHeadingFontSize}"
                                   TextAlignment="Center" HorizontalAlignment="Stretch"/>

                        <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                            <Button Style="{StaticResource QuickTile}" Margin="0,0,6,8" Click="GoToUpdate_Click" ToolTip="رفتن به صفحه به‌روزرسانی و گرفتن داده‌های تازه از سامانه." TabIndex="3" AutomationProperties.Name="به‌روزرسانی">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE895;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource SuccessTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="به‌روزرسانی" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="{DynamicResource CaptionFontSize}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="6,0,0,8" Click="GoToGenerator_Click" ToolTip="رفتن به تب تولید گزارش برای ساخت گزارش." TabIndex="4" AutomationProperties.Name="تولید گزارش">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE70C;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="تولید گزارش" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="{DynamicResource CaptionFontSize}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="0,0,6,0" Click="GoToCases_Click" ToolTip="رفتن به لیست پرونده‌ها." TabIndex="5" AutomationProperties.Name="پرونده‌ها">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="پرونده‌ها" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="{DynamicResource CaptionFontSize}"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource QuickTile}" Margin="6,0,0,0" Click="GoToFollowUp_Click" ToolTip="رفتن به صفحه پیگیری پرونده‌ها." TabIndex="6" AutomationProperties.Name="پیگیری">
                                <StackPanel>
                                    <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusIcon}" Background="{DynamicResource HoverOverlayBrush}"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="{DynamicResource SubHeadingFontSize}" Foreground="{DynamicResource WarningTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="پیگیری" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontWeight="SemiBold" FontSize="{DynamicResource CaptionFontSize}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,12"/>

                        <TextBlock Text="میانبرهای صفحه‌کلید" Style="{StaticResource StatLabel}" ToolTip="کلیدهایی که بدون موس به قسمت‌های اصلی می‌ری (Ctrl+D داشبورد، Ctrl+O به‌روزرسانی، Ctrl+G تولید گزارش)."
                                   Margin="0,0,0,8" FontWeight="SemiBold"/>

                        <Grid Margin="0,0,0,7">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Style="{StaticResource Kbd}">
                                    <TextBlock Text="Ctrl + D" FontSize="{DynamicResource CaptionFontSize}" FontFamily="Segoe UI"
