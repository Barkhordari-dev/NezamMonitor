<UserControl x:Class="NezamMonitorPro.App.Views.SettingsView" FlowDirection="{DynamicResource MainWindowFlowDirection}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="⚙️ تنظیمات رابط کاربری" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Theme Selection -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🎨 انتخاب تم" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="نام تم:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName}" Margin="0,0,0,0"/>
                        <Button Grid.Column="3" Content="اعمال تم" Command="{Binding ApplyThemeCommand}" Width="120" Height="36"
                                Background="{DynamicResource PrimaryBrush}" Foreground="White" FontSize="{DynamicResource LabelFontSize}" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>



            <!-- Fonts -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📝 فونت‌ها" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="خانواده فونت:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="اندازه کلی:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding FontSize}" Height="34" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="اندازه عنوان:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HeadingFontSize}" Height="34" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="اندازه دکمه:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ButtonFontSize}" Height="34" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="اندازه ورودی:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InputFontSize}" Height="34" VerticalContentAlignment="Center"/>

                        <Button Grid.Row="3" Grid.Column="1" Content="اعمال فونت‌ها" Command="{Binding ApplyFontsCommand}"
                                Width="120" Height="32" Background="{DynamicResource AccentBrush}" Foreground="White" FontSize="{DynamicResource LabelFontSize}" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>





            <!-- Status -->
            <Border Background="{DynamicResource TextBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" FontSize="{DynamicResource FontSize}" FontWeight="Bold"/>
            </Border>

            <!-- Factory Reset -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,15"
                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚠️ بازگشت به تنظیمات اولیه" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock Text="این عملیات تمام اطلاعات برنامه (پروندهها، تنظیمات، تاریخچه و اطلاعات ورود) را پاک میکند. قالبهای Word حفظ میشوند."
                               FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="پاکسازی کامل اطلاعات" Command="{Binding FactoryResetCommand}"
                            Width="220" Height="40" Background="{DynamicResource ErrorBrush}" Foreground="White"
                            FontSize="{DynamicResource FontSize}" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
