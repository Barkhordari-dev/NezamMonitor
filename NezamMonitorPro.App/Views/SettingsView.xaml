<UserControl x:Class="NezamMonitorPro.App.Views.SettingsView" FlowDirection="{DynamicResource MainWindowFlowDirection}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- ═══ Soft card ═══ -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#0B1B33"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Card header (icon + title) ═══ -->
        <Style x:Key="SettingsCardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Field label ═══ -->
        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- ═══ Rounded input ═══ -->
        <Style x:Key="SettingsInput" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Rounded combo box ═══ -->
        <Style x:Key="SettingsCombo" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource FontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ═══ Action buttons ═══ -->
        <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource ProButtonBase}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsDangerButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- ════════════ Theme ════════════ -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A2563EB" Margin="0,0,10,0">
                            <TextBlock Text="&#xE790;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="انتخاب تم" Style="{StaticResource SettingsCardTitle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="تم برنامه" Style="{StaticResource SettingsFieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <ComboBox Grid.Column="2" Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName}"
                                  HorizontalAlignment="Left" Width="240"/>
                        <Button Grid.Column="4" Style="{StaticResource SettingsPrimaryButton}"
                                Command="{Binding ApplyThemeCommand}" Content="اعمال تم"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════════════ Fonts ════════════ -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A7C3AED" Margin="0,0,10,0">
                            <TextBlock Text="&#xE8D2;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="فونتها" Style="{StaticResource SettingsCardTitle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="خانواده فونت" Style="{StaticResource SettingsFieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <ComboBox Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingsCombo}"
                                  ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}"
                                  HorizontalAlignment="Left" Width="220"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="اندازه کلی" Style="{StaticResource SettingsFieldLabel}"
                                   VerticalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingsInput}"
                                 Text="{Binding FontSize}" HorizontalAlignment="Left" Width="90" Margin="0,18,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="اندازه عنوان" Style="{StaticResource SettingsFieldLabel}"
                                   VerticalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingsInput}"
                                 Text="{Binding HeadingFontSize}" HorizontalAlignment="Left" Width="90" Margin="0,18,0,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="اندازه دکمه" Style="{StaticResource SettingsFieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBox Grid.Row="0" Grid.Column="6" Style="{StaticResource SettingsInput}"
                                 Text="{Binding ButtonFontSize}" HorizontalAlignment="Left" Width="90"/>

                        <TextBlock Grid.Row="1" Grid.Column="4" Text="اندازه ورودی" Style="{StaticResource SettingsFieldLabel}"
                                   VerticalAlignment="Center" Margin="0,18,0,0"/>
                        <TextBox Grid.Row="1" Grid.Column="6" Style="{StaticResource SettingsInput}"
                                 Text="{Binding InputFontSize}" HorizontalAlignment="Left" Width="90" Margin="0,18,0,0"/>

                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource SettingsPrimaryButton}"
                                Command="{Binding ApplyFontsCommand}" Content="اعمال فونتها"
                                HorizontalAlignment="Left" Margin="0,22,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════════════ Security / Password ════════════ -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1A10B981" Margin="0,0,10,0">
                            <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="امنیت و رمز عبور" Style="{StaticResource SettingsCardTitle}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="تغییر رمز عبور ورود و رمزنگاری پایگاه داده برنامه" Style="{StaticResource SettingsFieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,0,0" TextWrapping="Wrap"/>
                        <Button Grid.Column="2" Style="{StaticResource SettingsPrimaryButton}"
                                Command="{Binding ChangePasswordCommand}" Content="تغییر رمز عبور..."
                                MinWidth="160"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════════════ Status ════════════ -->
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextBrush}"
                           FontSize="13" FontWeight="Medium" TextWrapping="Wrap"/>
            </Border>

            <!-- ════════════ Factory reset ════════════ -->
            <Border Style="{StaticResource SettingsCard}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1.4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="#1AEF4444" Margin="0,0,10,0">
                            <TextBlock Text="&#xE7BA;" FontFamily="{DynamicResource IconFontFamily}" FontSize="15"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="پاکسازی کامل اطلاعات" Style="{StaticResource SettingsCardTitle}"/>
                    </StackPanel>

                    <TextBlock Text="تمام اطلاعات برنامه (پروندهها، گزارشها، حقالزحمهها، تاریخچه و اطلاعات ورود) پاک میشود. قالبهای Word و فهرست مهندسین حفظ میشوند. این عملیات قابل بازگشت نیست."
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Button Style="{StaticResource SettingsDangerButton}"
                            Command="{Binding FactoryResetCommand}" Content="پاکسازی کامل اطلاعات"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
