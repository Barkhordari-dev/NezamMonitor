<Window x:Class="NezamMonitorPro.App.Views.SnapshotViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource FontFamily}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,5" ToolTip="محتوای یک اسنپ‌شات رو فقط می‌بینی؛ هیچ چیز رو نمی‌تونی عوض کنی."/>
        <TextBlock Grid.Row="1" Text="{Binding SummaryText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,0,10"/>

        <!-- G-024: نوار «فقط‌خواندنی» بالای جدول (نه فقط در تیتر پنجره) -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="{DynamicResource RadiusSmall}" Padding="10,6" Margin="0,0,0,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="{DynamicResource FontSize}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="فقط‌خواندنی — این صفحه فقط برای دیدن است؛ چیزی اینجا تغییر نمی‌کند و ذخیره نمی‌شود."
                           FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Cases of this snapshot (read-only) -->
        <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="3" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" AutoGenerateColumns="False"
                  IsReadOnly="True" AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="All"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                  SelectionMode="Single" SelectionUnit="FullRow" FlowDirection="{DynamicResource TableFlowDirection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="شماره پرونده" Binding="{Binding CaseNumber}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="رشته" Binding="{Binding Responsibility}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="دفتر" Binding="{Binding Office}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                <DataGridTextColumn Header="مهندسین" Binding="{Binding Engineers.Count}" Width="Auto" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
                <DataGridTextColumn Header="حق‌الزحمه" Binding="{Binding Fees.Count}" Width="Auto" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
                <DataGridTextColumn Header="گزارش‌ها" Binding="{Binding Reports.Count}" Width="Auto" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selected case details (read-only) -->
        <TabControl Grid.Row="5">
            <TabItem Header="مهندسین">
                <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding SelectedCase.Engineers}" AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0" FlowDirection="{DynamicResource TableFlowDirection}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رشته" Binding="{Binding Discipline}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="نقش" Binding="{Binding Role}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="حق‌الزحمه">
                <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding SelectedCase.Fees}" AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0" FlowDirection="{DynamicResource TableFlowDirection}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رشته" Binding="{Binding Discipline}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="نوع خدمت" Binding="{Binding ServiceType}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="مرحله" Binding="{Binding Stage}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="وضعیت پرداخت" Binding="{Binding PayStatus}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="پایان" Binding="{Binding EndDate}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="گزارش‌ها">
                <DataGrid ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding SelectedCase.Reports}" AutoGenerateColumns="False" IsReadOnly="True"
                          AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" BorderThickness="0" FlowDirection="{DynamicResource TableFlowDirection}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ردیف" Binding="{Binding RowNo}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="نوع گزارش" Binding="{Binding ReportType}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="مرحله" Binding="{Binding Stage}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="مهندس" Binding="{Binding Engineer}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                        <DataGridTextColumn Header="تاریخ بازدید" Binding="{Binding VisitDate}" Width="Auto" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="6" Content="_بستن" Click="Close_Click" HorizontalAlignment="Left" MinWidth="100" Margin="0,10,0,0" ToolTip="بستن پنجره مشاهده اسنپ‌شات."
                Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold" TabIndex="1"/>
    </Grid>
</Window>
