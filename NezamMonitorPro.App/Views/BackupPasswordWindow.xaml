<Window x:Class="NezamMonitorPro.App.Views.BackupPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="رمز پشتیبان‌گیری"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🔐 رمز پشتیبان‌گیری" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"
                       ToolTip="رمز فایل پشتیبان را وارد کن."/>
            <TextBlock x:Name="HintText" Text="برای پشتیبان‌گیری، یک رمز بده؛ برای برگرداندن پشتیبان، همان رمزی که موقع پشتیبان‌گیری داده بودی را وارد کن. این رمز را جایی امن نگه دار؛ بدون آن، پشتیبان باز نمی‌شود."
                       FontSize="{DynamicResource LabelFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="رمز پشتیبان" FontSize="{DynamicResource LabelFontSize}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,14,0,6"/>
            <Grid>
                <PasswordBox x:Name="PasswordBox" Height="38" VerticalContentAlignment="Center"
                             ToolTip="رمز فایل پشتیبان؛ با چشم کنارش می‌تونی ببینیش."/>
                <TextBox x:Name="VisiblePasswordBox" Height="38" VerticalContentAlignment="Center"
                         Visibility="Collapsed" FontFamily="{StaticResource PathFontFamily}"
                         ToolTip="رمز فایل پشتیبان؛ با چشم کنارش می‌تونی ببینیش."/>
                <ToggleButton x:Name="ShowPasswordToggle" Width="34" Height="30"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                              Style="{StaticResource EyeButtonStyle}"
                              Checked="ShowPasswordToggle_Checked" Unchecked="ShowPasswordToggle_Unchecked"/>
            </Grid>

            <StackPanel x:Name="ConfirmPanel" Margin="0,14,0,0">
                <TextBlock Text="تکرار رمز پشتیبان" FontSize="{DynamicResource LabelFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                <Grid>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="38" VerticalContentAlignment="Center"
                                 ToolTip="رمز را دوباره بنویس تا مطمین شوی درست نوشته‌ای."/>
                    <TextBox x:Name="ConfirmVisibleBox" Height="38" VerticalContentAlignment="Center"
                             Visibility="Collapsed" FontFamily="{StaticResource PathFontFamily}"
                             ToolTip="رمز را دوباره بنویس تا مطمین شوی درست نوشته‌ای."/>
                    <ToggleButton x:Name="ShowConfirmToggle" Width="34" Height="30"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                  Style="{StaticResource EyeButtonStyle}"
                                  Checked="ShowConfirmToggle_Checked" Unchecked="ShowConfirmToggle_Unchecked"/>
                </Grid>
            </StackPanel>

            <!-- هشدار Caps Lock، مثل پنجره رمز برنامه. -->
            <TextBlock x:Name="CapsWarning" Visibility="Collapsed"
                       Text="⚠  Caps Lock روشن است" ToolTip="کلید Caps Lock روشن هست؛ رمز رو با حروف بزرگ می‌نویسی."
                       FontSize="11.5" Foreground="{DynamicResource WarningTextBrush}"
                       Margin="0,8,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorTextBrush}"
                       FontSize="{DynamicResource LabelFontSize}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" Content="_تایید" Click="ConfirmButton_Click" MinWidth="100" IsDefault="True"
                    ToolTip="رمز قبول می‌شود و کار ادامه پیدا می‌کند."/>
            <Button Content="_انصراف" Click="CancelButton_Click" Margin="8,0,0,0" MinWidth="100"
                    ToolTip="بدون انجام کار، این پنجره بسته می‌شود."/>
        </StackPanel>
    </Grid>
</Window>
