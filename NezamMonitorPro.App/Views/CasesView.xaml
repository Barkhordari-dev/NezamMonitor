<UserControl
             xmlns:local="clr-namespace:NezamMonitorPro.App.Converters" x:Class="NezamMonitorPro.App.Views.CasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="TableRow" Height="3*"/>
            <RowDefinition Height="5"/>
            <RowDefinition x:Name="DetailRow" Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Title + Search + Copy/Export + Reset + Refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="📋 پرونده‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,15,0"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="34" VerticalContentAlignment="Center" Margin="0,0,10,0" local:Watermark.Text="جستجو در پروندهها..." />
            <Button Grid.Column="2" Content="📋 کپی انتخاب‌شده" Click="CopySelected_Click"
                    Padding="12,0" Margin="0,0,6,0" Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="12"
                    ToolTip="ردیف‌های تیک‌خورده را TSV کپی می‌کند (برای Excel)"/>
            <Button Grid.Column="3" Content="📤 خروجی اکسل" Click="ExportSelected_Click"
                    Padding="12,0" Margin="0,0,6,0" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource OnSuccessBrush}" FontSize="12"
                    ToolTip="ردیف‌های تیک‌خورده را به اکسل B Nazanin 14 راست‌چین خروجی می‌دهد — اگر چیزی انتخاب نشده همه فیلتر فعلی"/>
            <Button Grid.Column="4" Content="↺ چینش پیش‌فرض" Click="ResetColumns_Click"
                    Padding="12,0" Margin="0,0,6,0" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" FontSize="12"
                    ToolTip="چیدمان ستون‌ها را به حالت اولیه برمی‌گرداند"/>
            <Button Grid.Column="5" Content="🔄" Command="{Binding RefreshCommand}"
                    Width="30" Height="30" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"/>
        </Grid>

        <!-- Main Table -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="4">
            <DataGrid x:Name="CasesGrid" ItemsSource="{Binding Cases}" AutoGenerateColumns="False"
                      IsReadOnly="False" AlternatingRowBackground="{DynamicResource PanelBrush}" GridLinesVisibility="All"
                      HeadersVisibility="Column" BorderThickness="0" CanUserSortColumns="True"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      PreviewMouseLeftButtonDown="CasesGrid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonUp="CasesGrid_PreviewMouseRightButtonUp"
                      SelectionChanged="CasesGrid_SelectionChanged" FlowDirection="{DynamicResource TableFlowDirection}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="☐" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="50" CanUserSort="False"/>
                    <DataGridTextColumn x:Name="ColRowNumber" Header="ردیف" Binding="{Binding RowNumber}" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
                    <DataGridTextColumn x:Name="ColCaseNumber" Header="شماره پرونده" Binding="{Binding CaseNumber}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColSerial" Header="شماره سریال" Binding="{Binding Serial}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwner" Header="نام مالک" Binding="{Binding Owner}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwnerMobile" Header="همراه مالک" Binding="{Binding OwnerMobile}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwnerFather" Header="نام پدر" Binding="{Binding OwnerFather}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwnerNationalCode" Header="کد ملی" Binding="{Binding OwnerNationalCode}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwnerTel" Header="تلفن مالک" Binding="{Binding OwnerTel}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwnerAddress" Header="آدرس مالک" Binding="{Binding OwnerAddress}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwnerZip" Header="کد پستی" Binding="{Binding OwnerZip}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOwnerBirthLoc" Header="زادگاه" Binding="{Binding OwnerBirthLoc}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColUsageType" Header="نوع کاربری" Binding="{Binding UsageType}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColBuildingGroup" Header="گروه ساختمانی" Binding="{Binding BuildingGroup}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColRenovationCode" Header="کد نوسازی" Binding="{Binding RenovationCode}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColPlanInstructionNo" Header="شماره دستور نقشه" Binding="{Binding PlanInstructionNo}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColPlanInstructionType" Header="نوع دستور نقشه" Binding="{Binding PlanInstructionType}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColPlanInstructionDate" Header="تاریخ دستور نقشه" Binding="{Binding PlanInstructionDate}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColLandArea" Header="مساحت زمین" Binding="{Binding LandArea}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColParafArea" Header="متراژ پاراف" Binding="{Binding ParafArea}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColCapacityArea" Header="متراژ کسر ظرفیت" Binding="{Binding CapacityArea}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColStructureType" Header="نوع سازه" Binding="{Binding StructureType}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColBlockTitle" Header="عنوان بلوک" Binding="{Binding BlockTitle}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColBlockCount" Header="تعداد بلوک" Binding="{Binding BlockCount}" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
                    <DataGridTextColumn x:Name="ColFloors" Header="طبقات" Binding="{Binding Floors}" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
                    <DataGridTextColumn x:Name="ColUnits" Header="واحدها" Binding="{Binding Units}" Width="Auto" IsReadOnly="True" HeaderStyle="{StaticResource GridHeaderCenter}" ElementStyle="{StaticResource GridCellEllipsisCenter}"/>
                    <DataGridTextColumn x:Name="ColIssuer" Header="صادرکننده پروانه" Binding="{Binding Issuer}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColPermitNumber" Header="شماره پروانه" Binding="{Binding PermitNumber}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColPermitDate" Header="تاریخ صدور پروانه" Binding="{Binding PermitDate}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColReleaseDate" Header="تاریخ ترخیص" Binding="{Binding ReleaseDate}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColPlanZone" Header="محدوده طرح" Binding="{Binding PlanZone}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColAddress" Header="آدرس" Binding="{Binding Address}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColOffice" Header="دفتر" Binding="{Binding Office}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColCapacityDate" Header="تاریخ کسر ظرفیت" Binding="{Binding CapacityDate}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                    <DataGridTextColumn x:Name="ColResponsibility" Header="مسئولیت" Binding="{Binding Responsibility}" Width="Auto" IsReadOnly="True" ElementStyle="{StaticResource GridCellEllipsis}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- GridSplitter - مستقیم بین جدول و جزئیات -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}" Cursor="SizeNS"
                      DragCompleted="GridSplitter_DragCompleted"/>

        <!-- Detail Panel -->
        <Border x:Name="DetailPanel" Grid.Row="3" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="15"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FlowDirection="RightToLeft"
                Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📄 جزئیات پرونده" FontSize="{DynamicResource FontSize}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DetailTitle}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold"
                               FontSize="{DynamicResource FontSize}" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="✕" Command="{Binding CloseDetailCommand}"
                            Width="25" Height="25" Background="{DynamicResource ErrorBrush}" Foreground="{DynamicResource OnErrorBrush}"
                            HorizontalAlignment="Right" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- 4-Column Horizontal Detail with GridSplitters -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Engineers -->
                    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="0,0,2,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="👷 ناظرین" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding DetailEngineers}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- GridSplitter 1 -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE"/>

                    <!-- Column 2: Fees -->
                    <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="2,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="💰 حق‌الزحمه" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding DetailFees}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- GridSplitter 2 -->
                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE"/>

                    <!-- Column 3: Reports -->
                    <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="2,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📄 گزارش‌ها" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding DetailReports}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- GridSplitter 3 -->
                    <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE"/>

                    <!-- Column 4: Specifications -->
                    <Border Grid.Column="6" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10" Margin="2,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📋 مشخصات" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding DetailSpecs}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource LabelFontSize}" Margin="0,5,0,0"/>
    </Grid>
</UserControl>
