<UserControl x:Class="NezamMonitorPro.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="SmallAction" TargetType="Button" BasedOn="{StaticResource ProButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="SmallGhost" TargetType="Button" BasedOn="{StaticResource ProButtonGhost}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="HistoryRoot" Margin="22,16,22,18" FlowDirection="RightToLeft"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ سرصفحه ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <TextBlock Text="تاریخچه و بایگانی" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="اسنپ‌شات‌های پایگاه‌داده فعال + بایگانی پایگاه‌داده‌های نسخه‌های قبلی (فقط‌خواندنی)"
                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0" TextAlignment="Center" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ═══ اسنپ‌شات‌ها ═══ -->
        <Border Grid.Row="1" Style="{StaticResource ProCard}" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="اسنپ‌شات‌های پایگاه‌داده فعال" ToolTip="نسخه‌هایی که از پایگاه داده فعلی گرفته شده؛ هر بروزرسانی یکی می‌سازه."
                               FontSize="{DynamicResource FontSize}" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               TextAlignment="Center" HorizontalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="برای ادغام، حداقل دو مورد را تیک بزنید"
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="ادغام انتخاب‌شده‌ها" Click="Merge_Click" ToolTip="دو یا چند اسنپ‌شات تیک‌خورده در هم ادغام می‌شن."
                                Style="{StaticResource SmallAction}"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="1" x:Name="SnapshotsList" ItemsSource="{Binding Snapshots}"
                         Background="Transparent" BorderThickness="0" FlowDirection="RightToLeft"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,9" CornerRadius="11"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid FlowDirection="RightToLeft">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForMerge}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="9"
                                            Background="#142563EB" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="4,0"/>

                                    <Button Grid.Column="3" Tag="{Binding Id}" Click="SetActive_Click" ToolTip="این اسنپ‌شات، پایگاه‌داده فعال می‌شه."
                                            Content="فعال‌سازی" Style="{StaticResource SmallGhost}"
                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="4" Tag="{Binding Id}" Click="Delete_Click" ToolTip="{Binding DeleteToolTip}"
                                            IsEnabled="{Binding CanDelete}"
                                            Content="حذف" Style="{StaticResource SmallAction}"
                                            Background="{DynamicResource ErrorBrush}"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ بایگانی نسخه‌های قبلی ═══ -->
        <Border Grid.Row="2" Style="{StaticResource ProCard}" Padding="16,14" Margin="0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="#14F59E0B"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource WarningTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="بایگانی پایگاه‌داده‌های نسخه‌های قبلی" FontSize="13.5" ToolTip="فایل‌های قدیمی فقط کپی و فقط‌خواندنی بررسی می‌شن؛ پایگاه‌داده فعلی با داده‌های جدید پر نمی‌شه."
                                   FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Text="فایل قدیمی فقط کپی و فقط‌خواندنی بررسی می‌شود؛ پایگاه‌داده فعلی با داده‌های جدید تکمیل می‌شود."
                                   FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="جستجوی خودکار" Click="ScanLegacy_Click" ToolTip="پیدا کردن خودکار پایگاه‌داده‌های قدیمی در پوشه‌ها."
                                Style="{StaticResource SmallGhost}" Margin="0,0,8,0"/>
                        <Button Content="افزودن فایل…" Click="AddLegacy_Click" ToolTip="انتخاب دستی یک فایل پایگاه‌داده قدیمی."
                                Style="{StaticResource SmallAction}" MinWidth="120"/>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,10"/>

                <!-- پایگاه‌داده‌های پیداشده -->
                <TextBlock Text="پایگاه‌داده‌های قدیمی پیداشده" FontSize="11"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6" TextAlignment="Center" HorizontalAlignment="Center"/>

                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DetectedDatabases}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" CornerRadius="10" Margin="0,0,0,5"
                                        Background="#0F2563EB"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <Run Text="{Binding Summary, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Tag="{Binding Path=Path}" Click="ImportLegacy_Click" ToolTip="وارد کردن کامل داده‌های یک فایل قدیمی به پایگاه‌داده فعلی."
                                                    Content="ایمپورت کامل" Style="{StaticResource SmallAction}"
                                                    MinWidth="120" Margin="0,0,6,0"/>
                                            <Button Tag="{Binding Path=Path}" Click="AttachDetected_Click" ToolTip="فرستادن پایگاه‌داده قدیمی به بایگانی."
                                                    Content="بایگانی" Style="{StaticResource SmallGhost}"
                                                    MinWidth="80"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- بایگانی‌شده‌ها -->
                <TextBlock Text="بایگانی‌شده" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,6"
                           TextAlignment="Center" HorizontalAlignment="Center"/>

                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding LegacyDatabases}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" CornerRadius="10" Margin="0,0,0,5"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <Run Text="{Binding Summary, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Tag="{Binding Path=Path}" Click="ImportLegacy_Click" ToolTip="وارد کردن کامل داده‌های یک فایل قدیمی به پایگاه‌داده فعلی."
                                                    Content="ایمپورت کامل" Style="{StaticResource SmallAction}"
                                                    MinWidth="120" Margin="0,0,6,0"/>
                                            <Button Tag="{Binding Path=Path}" Click="RemoveLegacy_Click"
                                                    Content="حذف" Style="{StaticResource SmallGhost}"
                                                    MinWidth="60"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding LegacyStatus}" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"
                           TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
