        <dependency id="Microsoft.Extensions.DependencyInjection.Abstractions" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="SQLitePCLRaw.bundle_e_sqlcipher" version="2.1.11" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
